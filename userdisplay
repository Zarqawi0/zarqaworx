local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Function para i-censor ang 50% ng pangalan
local function maskName(name)
	local length = #name
	if length <= 1 then
		return name
	end
	
	-- Kukunin ang unang 50% (kalahati) ng pangalan
	local keepLength = math.ceil(length * 0.50)
	local visiblePart = string.sub(name, 1, keepLength)
	local maskedPart = string.rep("*", length - keepLength)
	
	return visiblePart .. maskedPart
end

