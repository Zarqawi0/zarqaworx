local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

-- Force 3D Rendering OFF immediately when executed
RunService:Set3dRenderingEnabled(false)
local is3DEnabled = false

-- Ensure game and LocalPlayer are loaded
if not game:IsLoaded() then
	game.Loaded:Wait()
end

local LocalPlayer = Players.LocalPlayer or Players.PlayerAdded:Wait()
local playerGui = LocalPlayer:WaitForChild("PlayerGui", 15)

if not playerGui then
	warn("PlayerGui not found!")
	return
end

-- Function to mask 50% of the display name
local function maskName(name)
	local length = #name
	if length <= 1 then
		return name
	end
	
	local keepLength = math.ceil(length * 0.50)
	local visiblePart = string.sub(name, 1, keepLength)
	local maskedPart = string.rep("*", length - keepLength)
	
	return visiblePart .. maskedPart
end

-- ScreenGui Setup
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "TightProfileGUI"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

-- Tight Container Frame (Centered)
