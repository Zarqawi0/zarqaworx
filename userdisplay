local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

-- Ensure game and LocalPlayer are loaded before doing operations
if not game:IsLoaded() then
	game.Loaded:Wait()
end

local LocalPlayer = Players.LocalPlayer or Players.PlayerAdded:Wait()
local playerGui = LocalPlayer:WaitForChild("PlayerGui", 15)

if not playerGui then
	warn("PlayerGui not found!")
	return
end

-- State Management
local is3DEnabled = false
local renderConnection = nil

-- Throttles execution rate when 3D rendering is disabled to prevent CPU maxing out
local function update3DRendering(enabled)
	is3DEnabled = enabled
	RunService:Set3dRenderingEnabled(enabled)
	
	if not enabled then
		-- Cap rendering loops to ~30 FPS to drop CPU usage while 3D is off
		if not renderConnection then
			renderConnection = RunService.RenderStepped:Connect(function()
				task.wait(1 / 30)
			end)
		end
	else
		-- Clean up throttler when 3D rendering is restored
		if renderConnection then
			renderConnection:Disconnect()
			renderConnection = nil
		end
	end
end

-- Initialize 3D Rendering OFF
update3DRendering(false)

-- Function to mask 50% of the display name
local function maskName(name)
	local length = #name
	if length <= 1 then return name end
	
	local keepLength = math.ceil(length * 0.50)
	return string.sub(name, 1, keepLength) .. string.rep("*", length - keepLength)
end

