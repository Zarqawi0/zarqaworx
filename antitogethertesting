local function UpdateUI(statusText)
    if isPaused then
        local remaining = math.max(0, pauseEndTime - os.time())
        StatusLabel.Text = string.format("Paused (%ds remaining)", remaining)
    elseif statusText then 
        StatusLabel.Text = "Status: " .. statusText 
    end
    RefreshPlayerCount()
end

----------------------------------------------------------------
-- EVENT LISTENER (PAUSE MECHANISM)
----------------------------------------------------------------

task.spawn(function()
    local networkingFolder = ReplicatedStorage:WaitForChild("Packages", 10)
        and ReplicatedStorage.Packages:WaitForChild("Networking", 10)
    
    if networkingFolder then
        local Event = networkingFolder:WaitForChild("RE/EggWorld/FieldEggRedeemVerdict", 10)
        if Event and Event:IsA("RemoteEvent") then
            Event.OnClientEvent:Connect(function(data)
                if type(data) == "table" and data.Rarity and TARGET_RARITIES[data.Rarity] then
                    isPaused = true
                    pauseEndTime = os.time() + PAUSE_DURATION
                    UpdateUI(string.format("Found %s! Pausing...", data.Rarity))
                    
                    task.spawn(function()
                        task.wait(PAUSE_DURATION)
                        isPaused = false
                        UpdateUI("Resuming Scanning...")
                    end)
                end
            end)
        end
    end
end)

----------------------------------------------------------------
-- HTTP EXECUTOR COMPATIBILITY
----------------------------------------------------------------

local requestFunc = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
if not requestFunc then error("No supported HTTP request function found!") end

local function fetchServers(cursor)
    local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100&excludeFullGames=true", PlaceId)
    if cursor then url = url .. "&cursor=" .. cursor end

    local success, response = pcall(requestFunc, { Url = url, Method = "GET" })
    if success and response and response.Body then
        local successDecode, decoded = pcall(HttpService.JSONDecode, HttpService, response.Body)
        if successDecode then return decoded end
    end
    return nil
end

----------------------------------------------------------------
-- CORE CONTROLLER FUNCTIONS
----------------------------------------------------------------

local checkCurrentServer
local jobIdHop

local function findServer()
    UpdateUI("Searching 0-3 Players...")
    local claimedJobs = fetchJobs(true)
    
    local cursor = nil
    local totalScanned = 0
    local pageCount = 0

    while pageCount < 10 do
        pageCount = pageCount + 1
        local data = fetchServers(cursor)
        if not data or not data.data then break end

        local validServers = {}

        for _, server in ipairs(data.data) do
            if totalScanned > MAX_SERVER_INDEX then break end
            totalScanned = totalScanned + 1

            local playingCount = tonumber(server.playing)
            if playingCount and playingCount >= 0 and playingCount <= MAX_TARGET_PLAYERS then
                if server.id ~= CurrentJobId and not claimedJobs[server.id] and not visitedServers[server.id] then
                    table.insert(validServers, server.id)
                end
            end
        end

        if #validServers > 0 then
            local selectedId = validServers[math.random(1, #validServers)]
            
            cachedClaimedJobs[selectedId] = {
                userId = LocalPlayer.UserId,
                username = LocalPlayer.Name,
                jobId = selectedId,
                updatedAt = os.time()
            }
            
            claimServer(selectedId)
            return selectedId
        end

        cursor = data.nextPageCursor
        if not cursor or totalScanned > MAX_SERVER_INDEX then break end
        task.wait(0.1)
    end

    if next(visitedServers) then visitedServers = {} end
    return nil
end

jobIdHop = function()
    if isHopping or isPaused then return false end
    isHopping = true

    local now = os.time()
    local timeSinceLastHop = now - lastTeleportAttempt
    if timeSinceLastHop < TELEPORT_COOLDOWN then
        local waitTime = TELEPORT_COOLDOWN - timeSinceLastHop
        UpdateUI(string.format("Throttling (%ds)...", waitTime))
        task.wait(waitTime)
    end

    lastTeleportAttempt = os.time()

    local serverId = findServer()

    if not serverId then
        UpdateUI("No Server Found")
        isHopping = false
        task.wait(2)
        return false
    end

    visitedServers[serverId] = os.time()
    UpdateUI("Teleporting...")

    local teleportSuccess = pcall(function()
        TeleportService:TeleportToPlaceInstance(PlaceId, serverId, LocalPlayer)
    end)

    if not teleportSuccess then
        isHopping = false
        task.wait(retryDelay)
        retryDelay = math.min(retryDelay * 2, 10)
        return jobIdHop()
    end

    return true
end

checkCurrentServer = function()
    if isHopping or isPaused then return false end

    local count = RefreshPlayerCount()

    -- 1. Surge Guard Check (Triggers hop at 7 or more players)
    if count >= 7 then
        UpdateUI("Server Full (>=7)")
        task.spawn(jobIdHop)
        return false
    end

    -- 2. Claim & Ownership Verification (0-6 players)
    local claimedJobs = fetchJobs(true)
    local claimInfo = claimedJobs[CurrentJobId]

    if claimInfo and claimInfo.userId ~= LocalPlayer.UserId then
        UpdateUI("Already Claimed")
        task.spawn(jobIdHop)
        return false
    end

    claimServer(CurrentJobId)
    retryDelay = 1
    UpdateUI("Server Claimed")
    return true
end

----------------------------------------------------------------
-- LISTENERS & STARTUP INITIALIZATION
----------------------------------------------------------------

TeleportService.TeleportInitFailed:Connect(function()
    isHopping = false
    task.wait(retryDelay)
    retryDelay = math.min(retryDelay * 2, 10)
    checkCurrentServer()
end)

Players.PlayerAdded:Connect(function()
    RefreshPlayerCount()
    if not isHopping and not isPaused then checkCurrentServer() end
end)

Players.PlayerRemoving:Connect(function()
    RefreshPlayerCount()
    if not isHopping and not isPaused then checkCurrentServer() end
end)

-- Initial Startup Check with Replication Guard
task.spawn(function()
    UpdateUI("Syncing Server...")
    task.wait(2)
    RefreshPlayerCount()
    checkCurrentServer()
end)

-- Background Heartbeat Loop
task.spawn(function()
    while true do
        task.wait(HEARTBEAT_INTERVAL)
        if isPaused then
            UpdateUI()
        elseif not isHopping then
            checkCurrentServer()
        end
    end
end)
