    if not child:IsA("Player") then return end
    if isHopping == true then return end

    if child.Name == PROTECTED_USERNAME then
        print("Protected player left")
        task.wait(0.1)
        checkPlayerCount()
    else
        checkPlayerCount()
    end
end)

----------------------------------------------------------------
-- CONTINUOUS SCANNING & HEARTBEAT THREAD
----------------------------------------------------------------

task.spawn(function()
    -- Initial Check
    checkCurrentServer()
    task.wait(1)
