-- Enhanced Job Registration with sub-second timestamps to solve race conditions
local function registerJob()
    if writefile then
        local data = HttpService:JSONEncode({
            userId = LocalPlayer.UserId,
            username = LocalPlayer.Name,
            jobId = CurrentJobId,
            updatedAt = os.time(),
            preciseTime = os.clock() -- Sub-second precision tie-breaker
        })
        local success = pcall(writefile, MY_FILE_PATH, data)
        return success
    end
    return false
end

-- Fetch active server claims from filesystem
local function fetchJobs()
    local claimedJobs = {}
    
    if listfiles and readfile then
        local success, files = pcall(listfiles, FOLDER_NAME)
        if success and files then
            for _, filePath in ipairs(files) do
                local readSuccess, content = pcall(readfile, filePath)
                if readSuccess and content then
                    local decodeSuccess, parsed = pcall(HttpService.JSONDecode, HttpService, content)
                    if decodeSuccess and parsed and parsed.jobId and parsed.userId then
                        -- Ignore stale claims older than 10 minutes (600s)
                        if parsed.updatedAt and (os.time() - parsed.updatedAt) < 600 then
                            -- Store full metadata to resolve conflicts
                            if not claimedJobs[parsed.jobId] or (parsed.updatedAt < claimedJobs[parsed.jobId].updatedAt) then
                                claimedJobs[parsed.jobId] = parsed
                            end
                        end
                    end
                end
            end
        end
    end
    
    return claimedJobs
end

