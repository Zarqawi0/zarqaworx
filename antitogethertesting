----------------------------------------------------------------

local function RefreshPlayerCount()
    local count = #Players:GetPlayers()
    PlayersLabel.Text = string.format("Players: %d / 5", count)

    if count >= 5 then
        PlayersLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
    else
        PlayersLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
    end

    return count
end

local function UpdateUI(statusText, color)
    if statusText then
        StatusLabel.Text = "Status: " .. statusText
    end

    if color then
        StatusLabel.TextColor3 = color
    end

    RefreshPlayerCount()
end

----------------------------------------------------------------
-- DETERMINISTIC SERVER CLAIM SYSTEM
----------------------------------------------------------------

local function IsCurrentServerClaimedByMe()
    if not CurrentJobId or CurrentJobId == "" then
        return true
    end

    local currentPlayers = Players:GetPlayers()

    if #currentPlayers > MAX_CLAIM_PLAYERS + 1 then
        print("[Claim Check] Server rejected: Exceeds player limit.")
        return false
    end

    -- Lowest UserId breaks ties if multiple players run the script
    local lowestUserId = LocalPlayer.UserId
    local lowestUserObj = LocalPlayer

    for _, player in ipairs(currentPlayers) do
        if player and player.UserId then
            if player.UserId < lowestUserId then
                lowestUserId = player.UserId
                lowestUserObj = player
            end
        end
    end

    local holdsClaim = (LocalPlayer.UserId == lowestUserId)

    if not holdsClaim then
        print(string.format(
            "[Claim Check] Yielding: %s (%d) has lower UserId than you (%d)",
            lowestUserObj.Name,
            lowestUserId,
            LocalPlayer.UserId
        ))
    end

    return holdsClaim
end

----------------------------------------------------------------
-- HTTP EXECUTOR COMPATIBILITY
----------------------------------------------------------------

local requestFunc = nil
if syn and syn.request then requestFunc = syn.request
elseif http and http.request then requestFunc = http.request
elseif http_request then requestFunc = http_request
elseif fluxus and fluxus.request then requestFunc = fluxus.request
elseif request then requestFunc = request
else error("No supported HTTP request function found!") end

----------------------------------------------------------------
-- FETCH & RANDOMIZE SERVERS
----------------------------------------------------------------

local function fetchServers(cursor)
    local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", PlaceId)
    if cursor then url = url .. "&cursor=" .. cursor end

    local success, response = pcall(function()
        return requestFunc({ Url = url, Method = "GET" })
    end)

    if success and response and response.Body then
        local successDecode, decoded = pcall(function()
            return HttpService:JSONDecode(response.Body)
        end)
        if successDecode then return decoded end
    end
    return nil
end

local function ShuffleTable(tbl)
    for i = #tbl, 2, -1 do
        local j = math.random(1, i)
        tbl[i], tbl[j] = tbl[j], tbl[i]
    end
end

local function GetFiveRandomCandidates(candidates)
    local workingPool = {}
    for i, server in ipairs(candidates) do
        workingPool[i] = server
    end

    ShuffleTable(workingPool)

    local amount = math.min(RANDOM_PICK_COUNT, #workingPool)
    local fiveRandom = {}

    for i = 1, amount do
        table.insert(fiveRandom, workingPool[i])
    end

    return fiveRandom
end

----------------------------------------------------------------
-- FORWARD DECLARATION
----------------------------------------------------------------

local CheckAndHop

----------------------------------------------------------------
-- SERVER HOPPER
----------------------------------------------------------------

local isSearching = false

local function HopToLowServer()
    if isSearching then return end
    isSearching = true

    UpdateUI("Searching 0-299...", Color3.fromRGB(255, 180, 50))

    local cursor = nil
    local candidates = {}

    repeat
        local data = fetchServers(cursor)
        if not data or not data.data then break end

        for _, server in ipairs(data.data) do
            if #candidates >= (MAX_SERVER_INDEX + 1) then break end

            local playingCount = tonumber(server.playing)
            local validPlayerCount = playingCount ~= nil and playingCount >= 0 and playingCount <= MAX_TARGET_PLAYERS
            local notCurrentServer = server.id ~= CurrentJobId
            local notVisited = not visitedServers[server.id]

            if validPlayerCount and notCurrentServer and notVisited then
                table.insert(candidates, server)
            end
        end

        cursor = data.nextPageCursor
        task.wait(0.1)
    until not cursor or #candidates >= (MAX_SERVER_INDEX + 1)

    if #candidates == 0 then
        if next(visitedServers) then visitedServers = {} end
        UpdateUI("No Servers Found", Color3.fromRGB(255, 150, 50))
        task.wait(1.5)
        isSearching = false
        
        -- Re-evaluate current server state instead of leaving UI stuck
        task.defer(CheckAndHop)
        return
    end

    local fiveRandom = GetFiveRandomCandidates(candidates)
    local finalIndex = math.random(1, #fiveRandom)
    local selectedServer = fiveRandom[finalIndex]

    visitedServers[selectedServer.id] = os.time()

    UpdateUI("Teleporting...", Color3.fromRGB(100, 255, 100))

    local teleportSuccess = pcall(function()
        TeleportService:TeleportToPlaceInstance(PlaceId, selectedServer.id, LocalPlayer)
    end)

    if not teleportSuccess then
        UpdateUI("Teleport Failed", Color3.fromRGB(255, 80, 80))
        task.wait(1)
        isSearching = false
        task.defer(CheckAndHop)
    end
end

----------------------------------------------------------------
-- TELEPORT FAILURE HANDLER
----------------------------------------------------------------

TeleportService.TeleportInitFailed:Connect(function()
    isSearching = false
    UpdateUI("Teleport Canceled", Color3.fromRGB(255, 80, 80))
    task.defer(CheckAndHop)
end)

----------------------------------------------------------------
-- SERVER EVALUATION
----------------------------------------------------------------

CheckAndHop = function()
    local count = RefreshPlayerCount()

    if isSearching then return end

    -- Server full check (5+ players)
    if count >= 5 then
        UpdateUI("Server Full (5+)", Color3.fromRGB(255, 80, 80))
        task.defer(HopToLowServer)
        return
    end

    -- 0 to 4 players check
    local isOwner = IsCurrentServerClaimedByMe()

    if isOwner then
        UpdateUI("Claimed (" .. string.sub(tostring(CurrentJobId), 1, 6) .. ")", Color3.fromRGB(100, 255, 100))
    else
        UpdateUI("Yielding JobId...", Color3.fromRGB(255, 80, 80))
        task.wait(0.3)
        task.defer(HopToLowServer)
    end
end

