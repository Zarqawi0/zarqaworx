----------------------------------------------------------------
-- CONFIGURATION & CONSTANTS
----------------------------------------------------------------

local MAX_SERVER_INDEX = 299     -- Scan limit: 0-299 index (300 total)
local MAX_TARGET_PLAYERS = 3    -- Hop target server limit (0 to 3 players)
local MAX_ALLOWED_PLAYERS = 4   -- Server capacity limit (0-4 stay, 5+ hop)
local HEARTBEAT_INTERVAL = 3    -- Periodic sync interval in seconds
local TELEPORT_COOLDOWN = 5     -- Rate-limit guard: Minimum seconds between teleports
local LOCK_TIMEOUT = 5          -- Maximum seconds a lock file remains valid before breaking

local isHopping = false
local visitedServers = {}
local retryDelay = 1            -- Initial delay for exponential backoff
local lastTeleportAttempt = os.time()

-- File System Path Setup
local FOLDER_NAME = "JobIdClaims"

if isfolder and makefolder and not isfolder(FOLDER_NAME) then
    makefolder(FOLDER_NAME)
end

local function getJobFilePath(jobId)
    return string.format("%s/%s.json", FOLDER_NAME, jobId or CurrentJobId)
end

local function getLockFilePath(jobId)
    return string.format("%s/%s.lock", FOLDER_NAME, jobId or CurrentJobId)
end

----------------------------------------------------------------
-- FILE-LEVEL LOCKING MECHANISM
----------------------------------------------------------------

local function acquireServerLock(targetJobId)
    if not writefile or not isfile or not readfile then return true end
    local lockPath = getLockFilePath(targetJobId)
    local currentTime = os.time()

    -- Check if a lock file exists and is active
    if isfile(lockPath) then
        local readSuccess, content = pcall(readfile, lockPath)
        if readSuccess and content then
            local lockTime = tonumber(content)
            if lockTime and (currentTime - lockTime) < LOCK_TIMEOUT then
                -- Lock is actively held by another process; wait briefly and re-check
                task.wait(0.2)
                if isfile(lockPath) then
                    local recheckSuccess, recheckContent = pcall(readfile, lockPath)
                    if recheckSuccess and tonumber(recheckContent) and (currentTime - tonumber(recheckContent)) < LOCK_TIMEOUT then
                        return false -- Lock acquisition failed
                    end
                end
            end
        end
    end

    -- Write lock file with current timestamp
    pcall(writefile, lockPath, tostring(currentTime))
    return true
end

local function releaseServerLock(targetJobId)
    if not delfile or not isfile then return end
    local lockPath = getLockFilePath(targetJobId)
    if isfile(lockPath) then
        pcall(delfile, lockPath)
    end
end

----------------------------------------------------------------
-- AUTO-CLEANING STALE CLAIM & LOCK FILES
----------------------------------------------------------------

local function cleanupStaleFiles()
    if listfiles and delfile and readfile then
        local success, files = pcall(listfiles, FOLDER_NAME)
        if success and files then
            local currentTime = os.time()
            for _, filePath in ipairs(files) do
                if filePath:sub(-5) == ".lock" then
                    -- Clean up abandoned lock files older than LOCK_TIMEOUT
                    local readSuccess, content = pcall(readfile, filePath)
                    if readSuccess and content then
                        local lockTime = tonumber(content)
                        if lockTime and (currentTime - lockTime) > LOCK_TIMEOUT then
                            pcall(delfile, filePath)
                        end
                    end
                elseif filePath:sub(-5) == ".json" then
                    -- Clean up claim files older than 15 minutes
                    local readSuccess, content = pcall(readfile, filePath)
                    if readSuccess and content then
                        local decodeSuccess, parsed = pcall(HttpService.JSONDecode, HttpService, content)
                        if decodeSuccess and parsed and parsed.updatedAt then
                            if (currentTime - parsed.updatedAt) > 900 then
                                pcall(delfile, filePath)
                            end
                        end
                    end
                end
            end
        end
    end
end

task.spawn(cleanupStaleFiles)

----------------------------------------------------------------
-- FILE SYSTEM CACHING & ATOMIC REGISTRATION
----------------------------------------------------------------

local cachedClaimedJobs = {}

local function writeJobClaim(targetJobId, claimStatus)
    if not writefile then return nil end
    local jobId = targetJobId or CurrentJobId
    
    -- Attempt to acquire file lock before writing
    acquireServerLock(jobId)

    local filePath = getJobFilePath(jobId)
    local claimData = {
        userId = LocalPlayer.UserId,
        username = LocalPlayer.Name,
        jobId = jobId,
        status = claimStatus or "unclaimed",
        updatedAt = os.time()
    }
    pcall(writefile, filePath, HttpService:JSONEncode(claimData))
    cachedClaimedJobs[jobId] = claimData

    -- Release lock immediately after writing
    releaseServerLock(jobId)
    return claimData
end

local function readJobClaim(targetJobId)
    if not readfile or not isfile then return nil end
    local filePath = getJobFilePath(targetJobId)
    
    if isfile(filePath) then
        local readSuccess, content = pcall(readfile, filePath)
        if readSuccess and content then
            local decodeSuccess, parsed = pcall(HttpService.JSONDecode, HttpService, content)
            if decodeSuccess and parsed then
                if parsed.updatedAt and (os.time() - parsed.updatedAt) < 600 then
                    return parsed
                end
            end
        end
    end
    return nil
end

local function fetchAllSavedJobs()
    local currentTime = os.time()
    local claimedJobs = {}
    if listfiles and readfile then
        local success, files = pcall(listfiles, FOLDER_NAME)
        if success and files then
            for _, filePath in ipairs(files) do
                if filePath:sub(-5) == ".json" then
                    local readSuccess, content = pcall(readfile, filePath)
                    if readSuccess and content then
                        local decodeSuccess, parsed = pcall(HttpService.JSONDecode, HttpService, content)
                        if decodeSuccess and parsed and parsed.jobId then
                            if parsed.updatedAt and (currentTime - parsed.updatedAt) < 600 then
                                claimedJobs[parsed.jobId] = parsed
                            end
                        end
                    end
                end
            end
        end
    end
    return claimedJobs
end

