----------------------------------------------------------------
-- CONFIGURATION & CONSTANTS
----------------------------------------------------------------

local MAX_SERVER_INDEX = 299  -- Index range limit: 0 to 299 (300 servers maximum scan depth)
local MAX_SEARCH_PLAYERS = 3  -- SEARCH TARGET: Strictly 0 to 3 players when looking for a new server
local MAX_CLAIM_PLAYERS = 4   -- CLAIM TARGET: 0 to 4 players allowed to claim/stay (Hops if >= 5)
