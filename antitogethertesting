local function RefreshPlayerCount()
    local count = #Players:GetPlayers()
    PlayersLabel.Text = string.format("Players: %d", count)

    -- Any player count between 1 and 5 (excluding self) triggers red status
    if count >= 1 and count <= 5 then
        PlayersLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
    else
        PlayersLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
    end

    return count
end

local function UpdateUI(statusText, color)
    if statusText then
        StatusLabel.Text = "Status: " .. statusText
    end

    if color then
        StatusLabel.TextColor3 = color
    end

    RefreshPlayerCount()
end

local function ShuffleTable(tbl)
    for i = #tbl, 2, -1 do
        local j = math.random(1, i)
        tbl[i], tbl[j] = tbl[j], tbl[i]
    end
end

local function IsProtectedPlayerPresent()
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Name == PROTECTED_USERNAME then
            return true
        end
    end
    return false
end

