----------------------------------------------------------------
-- HELPER FUNCTIONS
----------------------------------------------------------------

local function RefreshPlayerCount()
    local count = #Players:GetPlayers()
    PlayersLabel.Text = "Players: " .. count
    PlayersLabel.TextColor3 = count > MAX_CLAIM_PLAYERS and Color3.fromRGB(255, 100, 100) or Color3.fromRGB(100, 255, 100)
    return count
end

local function UpdateUI(statusText, color)
    if statusText then StatusLabel.Text = "Status: " .. statusText end
    if color then StatusLabel.TextColor3 = color end
    RefreshPlayerCount()
end

----------------------------------------------------------------
-- HTTP EXECUTOR COMPATIBILITY
----------------------------------------------------------------

local requestFunc = syn and syn.request or http and http.request or http_request or fluxus and fluxus.request or request
if not requestFunc then error("No supported HTTP request function found!") end

local function fetchServers(cursor)
    local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", PlaceId)
    if cursor then url = url .. "&cursor=" .. cursor end

    local success, response = pcall(function()
        return requestFunc({ Url = url, Method = "GET" })
    end)

    if success and response and response.Body then
        local decodeSuccess, decoded = pcall(HttpService.JSONDecode, HttpService, response.Body)
        if decodeSuccess then return decoded end
    end
    return nil
end

----------------------------------------------------------------
-- CORE LOGIC (FORWARD DECLARATION)
----------------------------------------------------------------

local checkPlayerCount
local checkCurrentServer
local jobIdHop
local findServer

----------------------------------------------------------------
-- FIND SERVER PROCESS (1 REQUEST PER LOOP)
----------------------------------------------------------------

findServer = function()
    UpdateUI("Searching 0-3 Players...", Color3.fromRGB(255, 180, 50))

    local claimedJobs = fetchJobs()
    if not claimedJobs then return nil end

    local currentCursor = nil
    local totalScanned = 0

    while totalScanned < (MAX_SERVER_INDEX + 1) do
        local data = fetchServers(currentCursor)
        
        if data and data.data then
            for _, server in ipairs(data.data) do
                totalScanned = totalScanned + 1
                if totalScanned > (MAX_SERVER_INDEX + 1) then break end

                local playingCount = tonumber(server.playing)
                local maxPlayers = tonumber(server.maxPlayers) or 0

                -- Skip servers with > 3 players or full servers
                if not playingCount or playingCount > MAX_SEARCH_PLAYERS or (maxPlayers > 0 and playingCount >= maxPlayers) then
                    continue
                end

                -- Skip current, visited, or claimed servers
                if server.id == CurrentJobId or visitedServers[server.id] or claimedJobs[server.id] then
                    continue
                end

                return server.id
            end

            currentCursor = data.nextPageCursor
            if not currentCursor then break end
        else
            break
        end

        task.wait(0.2)
    end

    if next(visitedServers) then
        visitedServers = {}
    end

    return nil
end

----------------------------------------------------------------
-- JOBID HOP PROCESS
----------------------------------------------------------------

jobIdHop = function()
    if not isHopping then return false end

    local serverId = findServer()

    if not serverId then
        UpdateUI("No Server Found", Color3.fromRGB(255, 150, 50))
        task.wait(1)
        return isHopping and jobIdHop() or false
    end

    visitedServers[serverId] = os.time()
    UpdateUI("Teleporting...", Color3.fromRGB(100, 255, 100))

    local teleportSuccess = pcall(function()
        TeleportService:TeleportToPlaceInstance(PlaceId, serverId, LocalPlayer)
    end)

    if not teleportSuccess then
        task.wait(0.5)
        return isHopping and jobIdHop() or false
    end

    return true
end

----------------------------------------------------------------
-- CHECK PLAYER COUNT
----------------------------------------------------------------

checkPlayerCount = function()
    if isHopping then return false end

    if RefreshPlayerCount() > MAX_CLAIM_PLAYERS then
        isHopping = true
        UpdateUI("Server Full (>=7)", Color3.fromRGB(255, 80, 80))
        jobIdHop()
        return false
    end

    UpdateUI("Staying (Valid Count)", Color3.fromRGB(100, 255, 100))
    return true
end

----------------------------------------------------------------
-- CHECK & CLAIM CURRENT SERVER
----------------------------------------------------------------

checkCurrentServer = function()
    if RefreshPlayerCount() > MAX_CLAIM_PLAYERS then
        isHopping = true
        UpdateUI("Server Full (>=7)", Color3.fromRGB(255, 80, 80))
        jobIdHop()
        return false
    end

    isHopping = false

    local claimedJobs = fetchJobs()
    local claimData = claimedJobs[CurrentJobId]

    if claimData then
        if claimData.userId ~= LocalPlayer.UserId then
            isHopping = true
            UpdateUI("Job ID Claimed", Color3.fromRGB(255, 80, 80))
            jobIdHop()
            return false
        else
            registerJob()
            UpdateUI("Owned By Account", Color3.fromRGB(100, 255, 100))
            return true
        end
    end

    UpdateUI("Scanning & Claiming...", Color3.fromRGB(255, 180, 50))
    if registerJob() then
        task.wait(0.5)
        local confirmedClaim = fetchJobs()[CurrentJobId]

        if confirmedClaim and confirmedClaim.userId ~= LocalPlayer.UserId then
            isHopping = true
            UpdateUI("Claim Race Lost", Color3.fromRGB(255, 80, 80))
            jobIdHop()
            return false
        end

        UpdateUI("Claimed Server", Color3.fromRGB(100, 255, 100))
        return true
    end

    return false
end

----------------------------------------------------------------
-- EVENTS & INITIALIZATION
----------------------------------------------------------------

TeleportService.TeleportInitFailed:Connect(function()
    task.wait(0.5)
    if isHopping then jobIdHop() end
end)

Players.PlayerAdded:Connect(function(player)
    if player:IsA("Player") and not isHopping then
        checkPlayerCount()
    end
end)

Players.PlayerRemoving:Connect(function(player)
    if player:IsA("Player") and not isHopping then
        task.wait(0.1)
        checkPlayerCount()
    end
end)

task.spawn(function()
    if checkCurrentServer() then
        checkPlayerCount()
    end

    while true do
        task.wait(3)
        if not isHopping then
            checkCurrentServer()
        end
    end
end)
