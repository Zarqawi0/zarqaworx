    LastAttemptedJobId = nil
    task.wait(0.5)
    if isHopping then
        jobIdHop()
    end
end)

----------------------------------------------------------------
-- PLAYER EVENT LISTENERS
----------------------------------------------------------------

Players.PlayerAdded:Connect(function(child)
    if not child:IsA("Player") then return end
    if isHopping == true then return end

    if child.Name == PROTECTED_USERNAME then
        print("Protected player joined (do nothing)")
        UpdateUI("Protected Joined", Color3.fromRGB(100, 255, 100))
    else
        checkPlayerCount()
    end
end)

Players.PlayerRemoving:Connect(function(child)
    if not child:IsA("Player") then return end
    if isHopping == true then return end

    if child.Name == PROTECTED_USERNAME then
        print("Protected player left")
        task.wait(0.1)
        checkPlayerCount()
    else
        checkPlayerCount()
    end
end)

----------------------------------------------------------------
-- INITIALIZATION & HEARTBEAT
----------------------------------------------------------------

task.spawn(function()
    local initialClaimResult = checkCurrentServer()
    
    if initialClaimResult then
        checkPlayerCount()
    end

    while true do
        task.wait(3)
        if not isHopping then
            checkCurrentServer()
        end
    end
end)
