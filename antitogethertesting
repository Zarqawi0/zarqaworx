----------------------------------------------------------------
-- HTTP EXECUTOR COMPATIBILITY
----------------------------------------------------------------

local requestFunc = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
if not requestFunc then error("No supported HTTP request function found!") end

local function fetchServers(cursor)
    local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", PlaceId)
    if cursor then url = url .. "&cursor=" .. cursor end

    local success, response = pcall(requestFunc, { Url = url, Method = "GET" })
    if success and response and response.Body then
        local successDecode, decoded = pcall(HttpService.JSONDecode, HttpService, response.Body)
        if successDecode then return decoded end
    end
    return nil
end

----------------------------------------------------------------
-- CORE CONTROLLER FUNCTIONS
----------------------------------------------------------------

local checkCurrentServer
local jobIdHop

local function findServer()
    UpdateUI("Searching 0-3 Players...", Color3.fromRGB(255, 180, 50))
    local claimedJobs = fetchJobs()
    
    local cursor = nil
    local totalScanned = 0
    local pageCount = 0

    while pageCount < 10 do
        pageCount = pageCount + 1
        local data = fetchServers(cursor)
        if not data or not data.data then break end

        local validServers = {}

        for _, server in ipairs(data.data) do
            if totalScanned > MAX_SERVER_INDEX then break end
            totalScanned = totalScanned + 1

            local playingCount = tonumber(server.playing)
            if playingCount and playingCount >= 0 and playingCount <= MAX_TARGET_PLAYERS then
                if server.id ~= CurrentJobId and not claimedJobs[server.id] and not visitedServers[server.id] then
                    table.insert(validServers, server.id)
                end
            end
        end

        if #validServers > 0 then
            local selectedId = validServers[math.random(1, #validServers)]
            
            -- Pre-reserve in local memory cache to prevent cross-thread race conditions
            cachedClaimedJobs[selectedId] = {
                userId = LocalPlayer.UserId,
                username = LocalPlayer.Name,
                jobId = selectedId,
                updatedAt = os.time()
            }
            
            claimServer(selectedId)
            return selectedId
        end

        cursor = data.nextPageCursor
        if not cursor or totalScanned > MAX_SERVER_INDEX then break end
        task.wait(0.1)
    end

    if next(visitedServers) then visitedServers = {} end
    return nil
end

jobIdHop = function()
    if isHopping then return false end
    
    -- Lock state immediately BEFORE throttling yield to block incoming event threads
    isHopping = true

    -- Rate-limit guard delay
    local now = os.time()
    local timeSinceLastHop = now - lastTeleportAttempt
    if timeSinceLastHop < TELEPORT_COOLDOWN then
        local waitTime = TELEPORT_COOLDOWN - timeSinceLastHop
        UpdateUI(string.format("Throttling (%ds)...", waitTime), Color3.fromRGB(255, 180, 50))
        task.wait(waitTime)
    end

    lastTeleportAttempt = os.time()

    local serverId = findServer()

    if not serverId then
        UpdateUI("No Server Found", Color3.fromRGB(255, 150, 50))
        isHopping = false
        task.wait(1)
        checkCurrentServer()
        return false
    end

    visitedServers[serverId] = os.time()
    UpdateUI("Teleporting...", Color3.fromRGB(100, 255, 100))

    local teleportSuccess = pcall(function()
        TeleportService:TeleportToPlaceInstance(PlaceId, serverId, LocalPlayer)
    end)

    if not teleportSuccess then
        isHopping = false
        task.wait(retryDelay)
        retryDelay = math.min(retryDelay * 2, 10) -- Exponential backoff for synchronous errors
        return jobIdHop()
    end

    return true
end

checkCurrentServer = function()
    local count = RefreshPlayerCount()

    -- 1. Surge Guard Check (5+ players)
    if count > MAX_ALLOWED_PLAYERS then
        UpdateUI("Server Full (>=5)", Color3.fromRGB(255, 80, 80))
        jobIdHop()
        return false
    end

    -- 2. Claim & Ownership Verification (0-4 players)
    local claimedJobs = fetchJobs()
    local claimInfo = claimedJobs[CurrentJobId]

    if claimInfo and claimInfo.userId ~= LocalPlayer.UserId then
        UpdateUI("Already Claimed (Hopping)", Color3.fromRGB(255, 80, 80))
        jobIdHop()
        return false
    end

    -- Claim current server if unclaimed or renew timestamp if owned
    claimServer(CurrentJobId)
    isHopping = false
    retryDelay = 1 -- Reset exponential backoff counter on confirmed stay
    UpdateUI(claimInfo and "Owned By Account" or "Claimed Server (0-4)", Color3.fromRGB(100, 255, 100))
    return true
end

----------------------------------------------------------------
-- LISTENERS & HEARTBEAT LOOP
----------------------------------------------------------------

TeleportService.TeleportInitFailed:Connect(function()
    isHopping = false
    task.wait(retryDelay)
    retryDelay = math.min(retryDelay * 2, 10)
    checkCurrentServer()
end)

Players.PlayerAdded:Connect(function()
    if not isHopping then checkCurrentServer() end
end)

Players.PlayerRemoving:Connect(function()
    if not isHopping then checkCurrentServer() end
end)

-- Initial run & background Heartbeat (Every 3 Seconds)
checkCurrentServer()

task.spawn(function()
    while task.wait(HEARTBEAT_INTERVAL) do
        checkCurrentServer()
    end
end)
