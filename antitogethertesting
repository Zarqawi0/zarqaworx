--------------------------------------------------------------------------------
-- SERVER FETCHING WITH RANDOM INDEX & BATCH SELECTION (TARGET: 0-3 PLAYERS)
--------------------------------------------------------------------------------
local function fetchServers(cursor)
    local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", PlaceId)
    if cursor then
        url = url .. "&cursor=" .. cursor
    end
    
    local success, response = pcall(function()
        return requestFunc({ Url = url, Method = "GET" })
    end)
    
    if success and response and response.Body then
        local successDecode, decoded = pcall(function()
            return HttpService:JSONDecode(response.Body)
        end)
        if successDecode then return decoded end
    end
    return nil
end

local isSearching = false
local function HopToLowServer()
    if isSearching then return end
    isSearching = true

    local scanCount = 0
    while true do
        scanCount = scanCount + 1
        local cursor = nil
        local candidates = {}
        
        local randomIndex = math.random(0, 299)
        local targetSkipPages = math.floor(randomIndex / 100)
        local currentPage = 0

        UpdateUI(string.format("Searching...", scanCount), Color3.fromRGB(255, 180, 0))

        repeat
            local data = fetchServers(cursor)
            if data and data.data then
                currentPage = currentPage + 1
                
                if currentPage >= targetSkipPages then
                    for _, server in ipairs(data.data) do
                        local validPlayerCount = server.playing >= 0 and server.playing <= 3
                        local notCurrentServer = server.id ~= game.JobId
                        local noInlineQueue = not server.queuedPlayers or #server.queuedPlayers == 0

                        if validPlayerCount and notCurrentServer and noInlineQueue then
                            table.insert(candidates, server)
                        end
                    end
                end
                
                cursor = data.nextPageCursor
            else
                break
            end
            task.wait(0.15)
        until not cursor or #candidates >= 10

        if #candidates > 0 then
            local randomPool = {}
            local candidateCopy = { unpack(candidates) }
            
            for i = 1, math.min(5, #candidateCopy) do
                local pickIdx = math.random(1, #candidateCopy)
                table.insert(randomPool, candidateCopy[pickIdx])
                table.remove(candidateCopy, pickIdx)
            end

            local selectedServer = randomPool[math.random(1, #randomPool)]
            
            UpdateUI("Teleporting...", Color3.fromRGB(0, 255, 120))
            print(string.format("[ServerFinder] Teleporting to Server ID: %s (%d players)", tostring(selectedServer.id), selectedServer.playing))
            
            local teleportSuccess, err = pcall(function()
                TeleportService:TeleportToPlaceInstance(PlaceId, selectedServer.id, LocalPlayer)
            end)

            if not teleportSuccess then
                print("[ServerFinder] Teleport failed: " .. tostring(err) .. ". Retrying scan loop...")
                UpdateUI("Teleport Failed", Color3.fromRGB(255, 80, 80))
                isSearching = false
            end
            return
        end

        UpdateUI("Scanning...", Color3.fromRGB(255, 150, 50))
        task.wait(1.5)
    end
end

local function CheckAndHop()
    local count = #Players:GetPlayers()
    PlayerCountLabel.Text = string.format("Current Players: %d (Max limit: 5)", count)

    if count >= 5 then
        hasPrintedClaim = false
        ClearClaimTag()
        UpdateUI("Hopping...", Color3.fromRGB(255, 100, 100))
        HopToLowServer()
        return
    end

    -- Dynamic Claim Check
    local isClaimValid = ResolveClaimConflict()
    if not isClaimValid then
        -- Server claimed by someone else: Immediately Hop away
        UpdateUI("Server Claimed! Hopping...", Color3.fromRGB(255, 80, 80))
        print("[ServerFinder] Server already claimed by another client. Hopping...")
        task.wait(0.2)
        HopToLowServer()
        return
    else
        -- LocalPlayer holds the claim tag successfully
        UpdateUI("Claimed", Color3.fromRGB(0, 200, 255))
    end
end

-- Initialize Monitoring
task.spawn(function()
    while true do
        CheckAndHop()
        task.wait(0.5)
    end
end)

Players.PlayerAdded:Connect(function()
