task.wait(5)

local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")

local LocalPlayer = Players.LocalPlayer
while not LocalPlayer or not LocalPlayer.UserId do
    task.wait(0.1)
    LocalPlayer = Players.LocalPlayer
end

local PlaceId = game.PlaceId
local CurrentJobId = game.JobId

----------------------------------------------------------------
-- CONFIGURATION
----------------------------------------------------------------

local MAX_SERVER_INDEX = 299     -- Scan indices 0 to 299 (up to 10 pages of 100 limit)
local TARGET_MAX_PLAYERS = 3     -- Target servers with 0 to 3 players
local MAX_ALLOWED_PLAYERS = 4    -- 5 or more players triggers an immediate hop
local FOLDER_NAME = "JobIdClaims"
local MY_FILE_PATH = string.format("%s/%d.json", FOLDER_NAME, LocalPlayer.UserId)

local isHopping = false
local LastHopMethod = nil
local LastAttemptedJobId = nil
local visitedServers = {}

----------------------------------------------------------------
-- HTTP EXECUTOR COMPATIBILITY
----------------------------------------------------------------

local requestFunc = nil
if syn and syn.request then requestFunc = syn.request
elseif http and http.request then requestFunc = http.request
elseif http_request then requestFunc = http_request
elseif fluxus and fluxus.request then requestFunc = fluxus.request
elseif request then requestFunc = request
else error("No supported HTTP request function found!") end

----------------------------------------------------------------
-- FILE SYSTEM / CLAIMING SYSTEM (API FUNCTIONS)
----------------------------------------------------------------

if isfolder and makefolder and not isfolder(FOLDER_NAME) then
    makefolder(FOLDER_NAME)
end

local function registerJob()
    if writefile then
        local data = HttpService:JSONEncode({
            userId = LocalPlayer.UserId,
            username = LocalPlayer.Name,
            jobId = CurrentJobId,
            updatedAt = os.time()
        })
        return pcall(writefile, MY_FILE_PATH, data)
    end
    return false
end

local function fetchJobs()
    local claimedJobs = {}
    if listfiles and readfile then
        local success, files = pcall(listfiles, FOLDER_NAME)
        if success and files then
            for _, filePath in ipairs(files) do
                local readSuccess, content = pcall(readfile, filePath)
                if readSuccess and content then
                    local decodeSuccess, parsed = pcall(HttpService.JSONDecode, HttpService, content)
                    if decodeSuccess and parsed and parsed.jobId and parsed.userId then
                        -- Ignore claims older than 10 minutes
                        if parsed.updatedAt and (os.time() - parsed.updatedAt) < 600 then
                            claimedJobs[parsed.jobId] = parsed.userId
                        end
                    end
                end
            end
            return claimedJobs
        end
    end
    return nil -- Return nil on failure (matches flowchart)
end

----------------------------------------------------------------
-- FETCH ROBLOX SERVERS
----------------------------------------------------------------

local function fetchServers(cursor)
    local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", PlaceId)
    if cursor then url = url .. "&cursor=" .. cursor end

    local success, response = pcall(function()
        return requestFunc({ Url = url, Method = "GET" })
    end)

    if success and response and response.Body then
        local decodeSuccess, decoded = pcall(function()
            return HttpService:JSONDecode(response.Body)
        end)
        if decodeSuccess then return decoded end
    end
    return nil
end

----------------------------------------------------------------
-- FIND SERVER PROCESS (findServer)
----------------------------------------------------------------

local jobIdHop

local function findServer()
    -- Fetch registered jobs from API
    local claimedJobs = fetchJobs()
    if not claimedJobs then 
        return nil -- Return nil if failed to get jobs (matches flowchart)
    end

    local cursor = nil
    local pool300 = {}
    local totalScanned = 0

    -- Loop through Roblox public servers (up to 10 pages / index 0-299)
    repeat
        local data = fetchServers(cursor)
        if not data or not data.data then break end

        for _, server in ipairs(data.data) do
            totalScanned = totalScanned + 1
            if totalScanned > (MAX_SERVER_INDEX + 1) then break end

            local playing = tonumber(server.playing)
            
            -- Server Conditions:
            -- 1. Not current server (jobId)
            -- 2. Player count <= TARGET_MAX_PLAYERS (0 to 3)
            -- 3. Not owned by any user (from API)
            -- 4. Not visited
            local validPlayers = playing and playing >= 0 and playing <= TARGET_MAX_PLAYERS
            local isNotCurrent = server.id ~= CurrentJobId
            local isNotVisited = not visitedServers[server.id]
            local isNotClaimed = claimedJobs[server.id] == nil

            if validPlayers and isNotCurrent and isNotVisited and isNotClaimed then
                table.insert(pool300, server)
            end
        end

        cursor = data.nextPageCursor
        task.wait(0.1)
    until not cursor or totalScanned >= (MAX_SERVER_INDEX + 1)

    -- Found a valid server?
    if #pool300 == 0 then
        if next(visitedServers) then visitedServers = {} end
        return nil -- Return nil if no valid server found (matches flowchart)
    end

    -- Randomly pick 5 eligible servers from index 0-299 pool and select 1
    for i = #pool300, 2, -1 do
        local j = math.random(1, i)
        pool300[i], pool300[j] = pool300[j], pool300[i]
    end

    local pickCount = math.min(5, #pool300)
    local random5Pool = {}
    for i = 1, pickCount do
        table.insert(random5Pool, pool300[i])
    end

    local selectedServer = random5Pool[math.random(1, #random5Pool)]
    return selectedServer.id
end

----------------------------------------------------------------
-- JOBID HOP PROCESS (jobIdHop)
----------------------------------------------------------------

jobIdHop = function()
    -- Is hopping == true?
    if not isHopping then
        return false -- Return (Do nothing)
    end

    -- Find a new server
    local serverId = findServer()

    -- Found serverId?
    if not serverId then
        print("No suitable server")
        task.wait(1)
        if isHopping then
            return jobIdHop() -- Try again if still hopping
        end
        return false
    end

    -- Set LastHopMethod and LastAttemptedJobId
    LastHopMethod = "jobid"
    LastAttemptedJobId = serverId
    visitedServers[serverId] = os.time()

    -- Teleport to server
    local teleportSuccess = pcall(function()
        TeleportService:TeleportToPlaceInstance(PlaceId, serverId, LocalPlayer)
    end)

    -- Teleport call failed?
    if not teleportSuccess then
        LastAttemptedJobId = nil
        task.wait(0.5)
        if isHopping then
            return jobIdHop() -- Try again if still hopping
        end
    end

    print("Teleporting... (wait for result)")
    return true
end

----------------------------------------------------------------
-- SERVER CHECK LOGIC
----------------------------------------------------------------

local function checkCurrentServer()
    if isHopping then return end

    local count = #Players:GetPlayers()

    -- Rule: If 5 or more players, hop immediately
    if count > MAX_ALLOWED_PLAYERS then
        print("Server full (" .. count .. " players). Hopping immediately...")
        isHopping = true
        jobIdHop()
        return
    end

    -- Rule: Check if server is claimed already
    local claimedJobs = fetchJobs()
    if claimedJobs then
        local ownerId = claimedJobs[CurrentJobId]

        -- If another player claimed it, hop immediately
        if ownerId and ownerId ~= LocalPlayer.UserId then
            print("Server claimed by user " .. tostring(ownerId) .. ". Hopping immediately...")
            isHopping = true
            jobIdHop()
            return
        end

        -- If this account owns it, stay
        if ownerId and ownerId == LocalPlayer.UserId then
            print("Server belongs to this account")
            return
        end
    end

    -- Claim the server if eligible
    local regSuccess = registerJob()
    if regSuccess then
        print("Registration successful")
    end
end

----------------------------------------------------------------
-- TELEPORTINITFAILED EVENT (Matches Image)
----------------------------------------------------------------

TeleportService.TeleportInitFailed:Connect(function()
    print("Print teleport error")
    LastAttemptedJobId = nil
    task.wait(0.5)
    if isHopping then
        jobIdHop() -- Run jobIdHop() if still hopping
    end
end)

----------------------------------------------------------------
-- PLAYER LISTENERS & INITIALIZATION
----------------------------------------------------------------

Players.PlayerAdded:Connect(function()
    if isHopping then return end
    checkCurrentServer()
end)

Players.PlayerRemoving:Connect(function()
    if isHopping then return end
    task.wait(0.1)
    checkCurrentServer()
end)

-- Initial run upon loading in
checkCurrentServer()
