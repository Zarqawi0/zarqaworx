-- V2.2.0
-- 10s Initial Delay + Random 0-299 Server Pool
-- Select 5 Random Candidates -> Randomly Select 1 Final Server

----------------------------------------------------------------
-- 10 SECOND DELAY BEFORE SCRIPT EXECUTION
----------------------------------------------------------------

task.wait(10)

local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer

while not LocalPlayer or not LocalPlayer.UserId do
    task.wait(0.1)
    LocalPlayer = Players.LocalPlayer
end

local PlaceId = game.PlaceId
local CurrentJobId = game.JobId

-- [JobId] = timestamp
local visitedServers = {}

----------------------------------------------------------------
-- CONFIGURATION
----------------------------------------------------------------

local MAX_SERVER_INDEX = 299
local RANDOM_PICK_COUNT = 5

-- Server search target:
-- 0, 1, 2, or 3 players
local MAX_TARGET_PLAYERS = 3

-- Current server can be claimed when it has 0-4 players
local MAX_CLAIM_PLAYERS = 4

----------------------------------------------------------------
-- DETERMINISTIC SERVER CLAIM SYSTEM
----------------------------------------------------------------

local function IsCurrentServerClaimedByMe()

    if not CurrentJobId or CurrentJobId == "" then
        return true
    end

    local currentPlayers = Players:GetPlayers()

    -- Reject claim if server has 5 or more players
    if #currentPlayers >= 5 then
        print(
            "[Claim Check] Server rejected: Has "
            .. #currentPlayers
            .. " players (Max allowed is 4)"
        )

        return false
    end

    -- Lowest UserId wins the claim
    local lowestUserId = LocalPlayer.UserId
    local lowestUserObj = LocalPlayer

    for _, player in ipairs(currentPlayers) do

        if player and player.UserId then

            if player.UserId < lowestUserId then
                lowestUserId = player.UserId
                lowestUserObj = player
            end

        end

    end

    local holdsClaim = LocalPlayer.UserId == lowestUserId

    if not holdsClaim then

        print(
            string.format(
                "[Claim Check] Yielding: %s (%d) has lower UserId than you (%d)",
                lowestUserObj.Name,
                lowestUserId,
                LocalPlayer.UserId
            )
        )

    end

    return holdsClaim
end

