    PlayersLabel.Text = string.format("Players: %d / 5", count)

    if count > MAX_CLAIM_PLAYERS then
        PlayersLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
    else
        PlayersLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
    end

    return count
end

local function UpdateUI(statusText, color)
    if statusText then
        StatusLabel.Text = "Status: " .. statusText
    end

    if color then
        StatusLabel.TextColor3 = color
    end

    RefreshPlayerCount()
end

local function ShuffleTable(tbl)
    for i = #tbl, 2, -1 do
        local j = math.random(1, i)
        tbl[i], tbl[j] = tbl[j], tbl[i]
    end
end

----------------------------------------------------------------
-- HTTP EXECUTOR COMPATIBILITY
----------------------------------------------------------------

local requestFunc = nil
if syn and syn.request then requestFunc = syn.request
elseif http and http.request then requestFunc = http.request
elseif http_request then requestFunc = http_request
elseif fluxus and fluxus.request then requestFunc = fluxus.request
elseif request then requestFunc = request
else error("No supported HTTP request function found!") end

----------------------------------------------------------------
-- FETCH ROBLOX SERVERS
----------------------------------------------------------------

local function fetchServers(cursor)
    local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", PlaceId)
    if cursor then url = url .. "&cursor=" .. cursor end

    local success, response = pcall(function()
        return requestFunc({ Url = url, Method = "GET" })
    end)

    if success and response and response.Body then
        local successDecode, decoded = pcall(function()
            return HttpService:JSONDecode(response.Body)
        end)
        if successDecode then return decoded end
    end
    return nil
end

----------------------------------------------------------------
-- FORWARD DECLARATION
----------------------------------------------------------------

local CheckCurrentServer

----------------------------------------------------------------
-- HOP PIPELINE
----------------------------------------------------------------

local isSearching = false

local function Hop()
    if isSearching then return end
    isSearching = true

    UpdateUI("Searching 0-299...", Color3.fromRGB(255, 180, 50))

    local cursor = nil
    local pool300 = {}
    local totalScanned = 0

    -- STEP 1: Find 0 to 3 player count server up to candidate indexes 0-299
    repeat
        local data = fetchServers(cursor)
        if not data or not data.data then break end

        for _, server in ipairs(data.data) do
            totalScanned = totalScanned + 1
            if totalScanned > (MAX_SERVER_INDEX + 1) then break end

            local playingCount = tonumber(server.playing)
            local validPlayerCount = playingCount ~= nil and playingCount >= 0 and playingCount <= MAX_TARGET_PLAYERS
            local notCurrentServer = server.id ~= CurrentJobId
            local notVisited = not visitedServers[server.id]

            if validPlayerCount and notCurrentServer and notVisited then
                table.insert(pool300, server)
            end
        end

        cursor = data.nextPageCursor
        task.wait(0.1)
    until not cursor or totalScanned >= (MAX_SERVER_INDEX + 1)

    if #pool300 == 0 then
        if next(visitedServers) then visitedServers = {} end
        UpdateUI("No Servers Found", Color3.fromRGB(255, 150, 50))
        task.wait(1.5)
        isSearching = false
        task.defer(CheckCurrentServer)
        return
    end

    -- STEP 2: Shuffle entire pool
    ShuffleTable(pool300)

    -- STEP 3: Pick 5 random
    local random5Pool = {}
    local pickCount = math.min(5, #pool300)

    for i = 1, pickCount do
        table.insert(random5Pool, pool300[i])
    end

    -- STEP 4: Pick 1 randomly from those 5
    local candidates = { unpack(random5Pool) }
    ShuffleTable(candidates)

    -- STEP 5: Always check JSON file to ignore the Job ID that is claimed already
    local selectedServer = nil
    local claimedJobs = GetClaimDataFromStorage()

    for _, targetCandidate in ipairs(candidates) do
        if claimedJobs[targetCandidate.id] == nil then
            selectedServer = targetCandidate
            break
        end
    end

    -- Fallback: If all 5 chosen servers were claimed, search remaining candidates in pool300
    if not selectedServer then
        for _, candidate in ipairs(pool300) do
            if claimedJobs[candidate.id] == nil then
                selectedServer = candidate
                break
            end
        end
    end

    if not selectedServer then
        UpdateUI("All Candidate Jobs Claimed", Color3.fromRGB(255, 150, 50))
        task.wait(1.5)
        isSearching = false
        task.defer(CheckCurrentServer)
        return
    end

    visitedServers[selectedServer.id] = os.time()

    -- STEP 6: Join / Teleport
    UpdateUI("Joining Server...", Color3.fromRGB(100, 255, 100))

    local teleportSuccess = pcall(function()
        TeleportService:TeleportToPlaceInstance(PlaceId, selectedServer.id, LocalPlayer)
    end)

    if not teleportSuccess then
        UpdateUI("Teleport Failed", Color3.fromRGB(255, 80, 80))
        task.wait(1)
        isSearching = false
        task.defer(CheckCurrentServer)
    end
end

----------------------------------------------------------------
-- TELEPORT FAILURE HANDLER
----------------------------------------------------------------

TeleportService.TeleportInitFailed:Connect(function()
    isSearching = false
    UpdateUI("Teleport Canceled", Color3.fromRGB(255, 80, 80))
    task.defer(CheckCurrentServer)
end)

----------------------------------------------------------------
-- CHECK CURRENT SERVER EVALUATION FLOW
----------------------------------------------------------------

CheckCurrentServer = function()
    local count = RefreshPlayerCount()

    if isSearching then return end

    -- Path 1: 5 Above Player Count -> HOP
    if count > MAX_CLAIM_PLAYERS then
        UpdateUI("Server Full (5+)", Color3.fromRGB(255, 80, 80))
        task.defer(Hop)
        return
    end

    -- Path 2: Check the Job ID in JSON file if the other player claimed the Job ID
    local claimedJobs = GetClaimDataFromStorage()
    local myUserId = LocalPlayer.UserId
    local ownerId = claimedJobs[CurrentJobId]

    -- If the Job ID IS claimed -> HOP
    if ownerId and ownerId ~= myUserId then
        UpdateUI("Job ID Claimed -> Hopping", Color3.fromRGB(255, 80, 80))
        task.wait(0.2)
        task.defer(Hop)
        return
    end

    -- Path 3: If 0 to 4 Player Count AND Job ID is 'NOT' claimed -> CLAIM THE SERVER & STAY
    ClaimTheServer()
    UpdateUI("Staying (Claimed)", Color3.fromRGB(100, 255, 100))
end

