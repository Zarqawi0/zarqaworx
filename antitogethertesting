local cachedClaimedJobs = {}
local lastCacheUpdate = 0

-- 1. RESERVATION: Pre-locks target server before teleporting
-- FIX 2: Made synchronous (no task.spawn) during hop targeting to eliminate race conditions
local function reserveServer(targetJobId, isSync)
    local jobIdToReserve = targetJobId or CurrentJobId
    local username = LocalPlayer.Name
    local encodedName = safeUrlEncode(username)

    local function sendApiRequest()
        local url = string.format("%s/add?user=%s&jobid=%s&status=reserved", API_URL, encodedName, jobIdToReserve)[cite: 2]
        pcall(requestFunc, { Url = url, Method = "GET" })[cite: 2]
    end

    if isSync then
        sendApiRequest() -- Synchronous execution to prevent race condition
    else
        task.spawn(sendApiRequest) -- Async execution on join[cite: 2]
    end

    if writefile then
        local reserveData = {
            user = username,[cite: 3]
            jobId = jobIdToReserve,[cite: 3]
            status = "reserved",
            addedAt = os.date("!%Y-%m-%dT%H:%M:%S.000Z"),[cite: 3]
            updatedAt = os.time()
        }
        pcall(writefile, MY_FILE_PATH, HttpService:JSONEncode(reserveData))
        return reserveData
    end
    return nil
end

-- 2. ACTUAL CLAIM: Called only when player count condition (0 to 4) is met
local function claimServer(targetJobId)
    local jobIdToClaim = targetJobId or CurrentJobId
    local username = LocalPlayer.Name
    local encodedName = safeUrlEncode(username)

    task.spawn(function()
        local url = string.format("%s/add?user=%s&jobid=%s&status=claimed", API_URL, encodedName, jobIdToClaim)[cite: 2]
        pcall(requestFunc, { Url = url, Method = "GET" })[cite: 2]
    end)

    if writefile then
        local claimData = {
            user = username,[cite: 3]
            jobId = jobIdToClaim,[cite: 3]
            status = "claimed",
            addedAt = os.date("!%Y-%m-%dT%H:%M:%S.000Z"),[cite: 3]
            updatedAt = os.time()
        }
        pcall(writefile, MY_FILE_PATH, HttpService:JSONEncode(claimData))
        return claimData
    end
    return nil
end

local function fetchJobs(forceRefresh)
    local currentTime = os.time()
    if not forceRefresh and (currentTime - lastCacheUpdate) < 3 and next(cachedClaimedJobs) ~= nil then
        return cachedClaimedJobs
    end

    local claimedJobs = {}
    local apiSuccess = false

    local success, response = pcall(requestFunc, { Url = API_URL .. "/list", Method = "GET" })[cite: 2]
    if success and response and response.Body then
        local decodeSuccess, parsed = pcall(HttpService.JSONDecode, HttpService, response.Body)
        if decodeSuccess and type(parsed) == "table" and parsed.data then[cite: 3]
            apiSuccess = true
            for _, item in ipairs(parsed.data) do[cite: 3]
                if item.jobId then[cite: 3]
                    claimedJobs[item.jobId] = {
                        user = item.user,[cite: 3]
                        jobId = item.jobId,[cite: 3]
                        status = item.status or "claimed",
                        addedAt = item.addedAt,[cite: 3]
                        updatedAt = currentTime
                    }
                end
            end
        end
    end

    if not apiSuccess and listfiles and readfile then
        local fileSuccess, files = pcall(listfiles, FOLDER_NAME)
        if fileSuccess and files then
            for _, filePath in ipairs(files) do
                local readSuccess, content = pcall(readfile, filePath)
                if readSuccess and content then
                    local decodeSuccess, parsed = pcall(HttpService.JSONDecode, HttpService, content)
                    if decodeSuccess and parsed and parsed.jobId then
                        if parsed.updatedAt and (currentTime - parsed.updatedAt) < 600 then
                            if not claimedJobs[parsed.jobId] or (parsed.updatedAt < claimedJobs[parsed.jobId].updatedAt) then
                                claimedJobs[parsed.jobId] = parsed
                            end
                        end
                    end
                end
            end
        end
    end

    for jobId, memoryClaim in pairs(cachedClaimedJobs) do
        if memoryClaim.user == LocalPlayer.Name and (currentTime - memoryClaim.updatedAt) < 30 then
            if not claimedJobs[jobId] then
                claimedJobs[jobId] = memoryClaim
            end
        end
    end

    cachedClaimedJobs = claimedJobs
    lastCacheUpdate = currentTime
    return claimedJobs
end

