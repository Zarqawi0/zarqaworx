----------------------------------------------------------------
-- FIND SERVER PROCESS (findServer)
----------------------------------------------------------------

findServer = function()
    UpdateUI("Searching 0-299...", Color3.fromRGB(255, 180, 50))

    local claimedJobs = fetchJobs()
    if not claimedJobs then
        return nil
    end

    local cursor = nil
    local pool300 = {}
    local totalScanned = 0

    repeat
        local data = fetchServers(cursor)
        if not data or not data.data then break end

        for _, server in ipairs(data.data) do
            totalScanned = totalScanned + 1
            if totalScanned > (MAX_SERVER_INDEX + 1) then break end

            local playingCount = tonumber(server.playing)
            local validPlayerCount = playingCount ~= nil and playingCount <= MAX_TARGET_PLAYERS
            local notCurrentServer = server.id ~= CurrentJobId
            local notVisited = not visitedServers[server.id]
            local notOwned = claimedJobs[server.id] == nil

            if validPlayerCount and notCurrentServer and notVisited and notOwned then
                table.insert(pool300, server)
            end
        end

        cursor = data.nextPageCursor
        task.wait(0.1)
    until not cursor or totalScanned >= (MAX_SERVER_INDEX + 1)

    if #pool300 == 0 then
        if next(visitedServers) then visitedServers = {} end
        return nil
    end

    ShuffleTable(pool300)

    local random5Pool = {}
    local pickCount = math.min(5, #pool300)

    for i = 1, pickCount do
        table.insert(random5Pool, pool300[i])
    end

    local selectedServer = random5Pool[math.random(1, #random5Pool)]
    return selectedServer.id
end

----------------------------------------------------------------
-- JOBID HOP PROCESS (jobIdHop)
----------------------------------------------------------------

jobIdHop = function()
    if isHopping == false then
        return false
    end

    local serverId = findServer()

    if not serverId then
        print("No suitable server found")
        UpdateUI("No Server Found", Color3.fromRGB(255, 150, 50))
        task.wait(1)
        if isHopping then
            return jobIdHop()
        end
        return false
    end

    LastHopMethod = "jobid"
    LastAttemptedJobId = serverId
    visitedServers[serverId] = os.time()

    UpdateUI("Teleporting...", Color3.fromRGB(100, 255, 100))

    local teleportSuccess = pcall(function()
        TeleportService:TeleportToPlaceInstance(PlaceId, serverId, LocalPlayer)
    end)

    if not teleportSuccess then
        LastAttemptedJobId = nil
        task.wait(0.5)
        if isHopping then
            return jobIdHop()
        end
    end

    return true
end

----------------------------------------------------------------
-- CHECK PLAYER COUNT PROCESS (checkPlayerCount)
----------------------------------------------------------------

checkPlayerCount = function()
    if isHopping == true then
        return false
    end

    local count = RefreshPlayerCount()

    if IsProtectedPlayerPresent() then
        UpdateUI("Protected Present", Color3.fromRGB(100, 255, 100))
        return true
    end

    -- IMMEDIATELY HOP IF PLAYERS ARE BETWEEN 1 AND 5
    if count >= 1 and count <= 5 then
        isHopping = true
        UpdateUI("1-5 Players (Hopping)", Color3.fromRGB(255, 80, 80))
        jobIdHop()
        return false
    end

    UpdateUI("Staying (Valid Count)", Color3.fromRGB(100, 255, 100))
    return true
end

----------------------------------------------------------------
-- CHECK CURRENT SERVER PROCESS (checkCurrentServer)
----------------------------------------------------------------

checkCurrentServer = function()
    if isHopping == true then
        return false
    end

    local count = RefreshPlayerCount()
    local protectedPresent = IsProtectedPlayerPresent()

    -- 1. Check Player Count criteria (Immediate Hop for 1-5 players unless protected is present)
    if (not protectedPresent) and (count >= 1 and count <= 5) then
        isHopping = true
        UpdateUI("1-5 Players (Hopping)", Color3.fromRGB(255, 80, 80))
        jobIdHop()
        return false
    end

    -- 2. Claim check & Conflict Resolution
    local claimedJobs = fetchJobs()
    local claimData = claimedJobs[CurrentJobId]

    if claimData then
        -- Job is owned by someone else
        if claimData.userId ~= LocalPlayer.UserId then
            isHopping = true
            UpdateUI("Job ID Claimed", Color3.fromRGB(255, 80, 80))
            jobIdHop()
            return false
        else
            -- Check if another account attempted to claim at nearly the same time
            -- Refresh claim timestamp to maintain active lease
            registerJob()
            UpdateUI("Owned By Account", Color3.fromRGB(100, 255, 100))
            return true
        end
    end

    -- 3. Attempt to Claim the server
    local regSuccess = registerJob()
    if regSuccess then
        -- Anti-Race Verification: Pause briefly and confirm claim was registered first
        task.wait(0.5)
        local postClaimJobs = fetchJobs()
        local confirmedClaim = postClaimJobs[CurrentJobId]

        if confirmedClaim and confirmedClaim.userId ~= LocalPlayer.UserId then
            -- Lost race condition
            isHopping = true
            UpdateUI("Claim Race Lost", Color3.fromRGB(255, 80, 80))
            jobIdHop()
            return false
        end

        print("Claimed server successfully")
        UpdateUI("Claimed Server", Color3.fromRGB(100, 255, 100))
        return true
    end

    return false
end

