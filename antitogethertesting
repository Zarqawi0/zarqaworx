local PlaceId = game.PlaceId
local CurrentJobId = game.JobId
local visitedServers = {} -- [JobId] = timestamp

--------------------------------------------------------------------------------
-- DETERMINISTIC SERVER CLAIM SYSTEM (PULLS USERID RANKING)
--------------------------------------------------------------------------------
local function IsCurrentServerClaimedByMe()
    if not CurrentJobId or CurrentJobId == "" then return true end

    local currentPlayers = Players:GetPlayers()
    
    -- If player count exceeds 4 (5+), nobody can claim this server -> auto-hop
    if #currentPlayers >= 5 then
        return false
    end

    -- Deterministic tie-breaker: Lowest UserId claims the server
    local lowestUserId = LocalPlayer.UserId
    for _, player in ipairs(currentPlayers) do
        if player and player.UserId then
            if player.UserId < lowestUserId then
                lowestUserId = player.UserId
            end
        end
    end

    -- If this player has the lowest UserId, claim it. All other script users yield instantly.
    return LocalPlayer.UserId == lowestUserId
end

