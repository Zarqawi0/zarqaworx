----------------------------------------------------------------
-- PLAYER COUNT
----------------------------------------------------------------

local function RefreshPlayerCount()

    local count = #Players:GetPlayers()

    PlayersLabel.Text = string.format(
        "Players: %d / 5",
        count
    )

    if count >= 5 then

        PlayersLabel.TextColor3 =
            Color3.fromRGB(255, 100, 100)

    else

        PlayersLabel.TextColor3 =
            Color3.fromRGB(100, 255, 100)

    end

    return count
end

local function UpdateUI(statusText, color)

    if statusText then
        StatusLabel.Text = "Status: " .. statusText
    end

    if color then
        StatusLabel.TextColor3 = color
    end

    RefreshPlayerCount()
end

----------------------------------------------------------------
-- HTTP EXECUTOR COMPATIBILITY
----------------------------------------------------------------

local requestFunc = nil

if syn and syn.request then

    requestFunc = syn.request

elseif http and http.request then

    requestFunc = http.request

elseif http_request then

    requestFunc = http_request

elseif fluxus and fluxus.request then

    requestFunc = fluxus.request

elseif request then

    requestFunc = request

else

    error("No supported HTTP request function found!")

end

----------------------------------------------------------------
-- FETCH ROBLOX SERVERS
----------------------------------------------------------------

local function fetchServers(cursor)

    local url = string.format(
        "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100",
        PlaceId
    )

    if cursor then
        url = url .. "&cursor=" .. cursor
    end

    local success, response = pcall(function()

        return requestFunc({
            Url = url,
            Method = "GET"
        })

    end)

    if success and response and response.Body then

        local successDecode, decoded = pcall(function()

            return HttpService:JSONDecode(response.Body)

        end)

        if successDecode then
            return decoded
        end

    end

    return nil
end

----------------------------------------------------------------
-- RANDOMIZE TABLE
----------------------------------------------------------------

local function ShuffleTable(tbl)

    for i = #tbl, 2, -1 do

        local j = math.random(1, i)

        tbl[i], tbl[j] = tbl[j], tbl[i]

    end

end

----------------------------------------------------------------
-- PICK 5 RANDOM CANDIDATES
----------------------------------------------------------------

local function GetFiveRandomCandidates(candidates)

    local workingPool = {}

    -- Copy candidates
    for i, server in ipairs(candidates) do
        workingPool[i] = server
    end

    -- Completely randomize the pool
    ShuffleTable(workingPool)

    local amount = math.min(
        RANDOM_PICK_COUNT,
        #workingPool
    )

    local fiveRandom = {}

    for i = 1, amount do

        table.insert(
            fiveRandom,
            workingPool[i]
        )

    end

    return fiveRandom
end

----------------------------------------------------------------
-- SERVER HOPPER
--
-- Collects up to 300 eligible servers.
--
-- Conceptual indexes:
-- 0
-- 1
-- 2
-- ...
-- 299
--
-- Lua internally uses 1-300.
----------------------------------------------------------------

local isSearching = false

local function HopToLowServer()

    if isSearching then
        return
    end

    isSearching = true

    UpdateUI(
        "Searching 0-299...",
        Color3.fromRGB(255, 180, 50)
    )

    local cursor = nil
    local candidates = {}

    ----------------------------------------------------------------
    -- COLLECT UP TO 300 SERVERS
    ----------------------------------------------------------------

    repeat

        local data = fetchServers(cursor)

        if not data or not data.data then
            break
        end

        for _, server in ipairs(data.data) do

            -- Stop once we have 300 candidates
            if #candidates >= (MAX_SERVER_INDEX + 1) then
                break
            end

            local playingCount = tonumber(server.playing)

            local validPlayerCount =
                playingCount ~= nil
                and playingCount >= 0
                and playingCount <= MAX_TARGET_PLAYERS

            local notCurrentServer =
                server.id ~= CurrentJobId

            local notVisited =
                not visitedServers[server.id]

            if validPlayerCount
                and notCurrentServer
                and notVisited then

                table.insert(
                    candidates,
                    server
                )

            end

        end

        cursor = data.nextPageCursor

        task.wait(0.1)

    until
        not cursor
        or #candidates >= (MAX_SERVER_INDEX + 1)

    ----------------------------------------------------------------
    -- NO CANDIDATES
    ----------------------------------------------------------------

    if #candidates == 0 then

        if next(visitedServers) then
            visitedServers = {}
        end

        UpdateUI(
            "No Servers Found",
            Color3.fromRGB(255, 150, 50)
        )

        task.wait(1)

        isSearching = false

        return
    end

    ----------------------------------------------------------------
    -- SHOW POOL SIZE
    ----------------------------------------------------------------

    print(
        "[Server Search] Found "
        .. #candidates
        .. " eligible servers."
    )

    ----------------------------------------------------------------
    -- SELECT 5 RANDOM SERVERS
    ----------------------------------------------------------------

    local fiveRandom =
        GetFiveRandomCandidates(candidates)

    print(
        "[Server Search] Selected "
        .. #fiveRandom
        .. " random candidates."
    )

    ----------------------------------------------------------------
    -- PRINT THE 5 RANDOM CANDIDATES
    ----------------------------------------------------------------

    for index, server in ipairs(fiveRandom) do

        print(
            string.format(
                "[Random Candidate %d] %s (%d/5 players)",
                index,
                tostring(server.id),
                tonumber(server.playing) or 0
            )
        )

    end

    ----------------------------------------------------------------
    -- RANDOMLY PICK ONE OF THE 5
    ----------------------------------------------------------------

    local finalIndex =
        math.random(1, #fiveRandom)

    local selectedServer =
        fiveRandom[finalIndex]

    ----------------------------------------------------------------
    -- CONVERT TO CONCEPTUAL 0-299 INDEX
    ----------------------------------------------------------------

    -- candidates is Lua 1-based.
    -- Therefore:
    --
    -- Lua index 1 = conceptual index 0
    -- Lua index 2 = conceptual index 1
    -- ...
    -- Lua index 300 = conceptual index 299

    local conceptualIndex = nil

    for i, server in ipairs(candidates) do

        if server.id == selectedServer.id then

            conceptualIndex = i - 1
            break

        end

    end

    ----------------------------------------------------------------
    -- MARK VISITED
    ----------------------------------------------------------------

    visitedServers[selectedServer.id] = os.time()

    print(
        "================================================"
    )

    print(
        "[Server Search] FINAL RANDOM PICK"
    )

    print(
        "[Server Search] Index: "
        .. tostring(conceptualIndex)
        .. " / 299"
    )

    print(
        "[Server Search] JobId: "
        .. tostring(selectedServer.id)
    )

    print(
        "[Server Search] Players: "
        .. tostring(selectedServer.playing)
        .. "/5"
    )

    print(
        "[Server Search] Chosen from "
        .. #fiveRandom
        .. " random candidates."
    )

    print(
        "================================================"
    )

    ----------------------------------------------------------------
    -- UPDATE UI
    ----------------------------------------------------------------

    UpdateUI(
        "Teleporting...",
        Color3.fromRGB(100, 255, 100)
    )

    ----------------------------------------------------------------
    -- TELEPORT
    ----------------------------------------------------------------

    local teleportSuccess = pcall(function()

        TeleportService:TeleportToPlaceInstance(
            PlaceId,
            selectedServer.id,
            LocalPlayer
        )

    end)

    if not teleportSuccess then

        UpdateUI(
            "Teleport Failed",
            Color3.fromRGB(255, 80, 80)
        )

        task.wait(1)

        isSearching = false

    end
end

----------------------------------------------------------------
-- TELEPORT FAILURE
----------------------------------------------------------------

TeleportService.TeleportInitFailed:Connect(function()

    isSearching = false

    UpdateUI(
        "Teleport Canceled",
        Color3.fromRGB(255, 80, 80)
    )

end)

----------------------------------------------------------------
-- SERVER EVALUATION
----------------------------------------------------------------

local function CheckAndHop()

    local count = RefreshPlayerCount()

    if isSearching then
        return
    end

    ----------------------------------------------------------------
    -- 5+ PLAYERS = SERVER TOO FULL
    ----------------------------------------------------------------

    if count >= 5 then

        UpdateUI(
            "Server Full (5+)",
            Color3.fromRGB(255, 80, 80)
        )

        task.defer(HopToLowServer)

        return
    end

    ----------------------------------------------------------------
    -- 0-4 PLAYERS = CHECK CLAIM
    ----------------------------------------------------------------

    local isOwner =
        IsCurrentServerClaimedByMe()

    if isOwner then

        UpdateUI(
            "Claimed ("
            .. string.sub(
                tostring(CurrentJobId),
                1,
                6
            )
            .. ")",
            Color3.fromRGB(100, 255, 100)
        )

    else

        UpdateUI(
            "Yielding JobId...",
            Color3.fromRGB(255, 80, 80)
        )

        task.wait(0.3)

        task.defer(HopToLowServer)

    end
end

----------------------------------------------------------------
-- INITIAL CHECK
----------------------------------------------------------------

CheckAndHop()

