-- Fully Conflict-Free Multi-Account Target Hopper & Instant Claim Guard

task.wait(10)

local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer

while not LocalPlayer or not LocalPlayer.UserId do
    task.wait(0.1)
    LocalPlayer = Players.LocalPlayer
end

local PlaceId = game.PlaceId
local CurrentJobId = game.JobId

----------------------------------------------------------------
-- CONFIGURATION & CONSTANTS
----------------------------------------------------------------

local MAX_SERVER_INDEX = 299     -- Scan limit: 0-299 index (300 total)
local MAX_TARGET_PLAYERS = 3    -- Hop target server limit (0 to 3 players)
local MAX_ALLOWED_PLAYERS = 4   -- Server capacity limit (0-4 stay, 5+ hop)
local HEARTBEAT_INTERVAL = 3    -- Periodic sync interval in seconds
local TELEPORT_COOLDOWN = 5     -- Rate-limit guard: Minimum seconds between teleports

local isHopping = false
local visitedServers = {}
local retryDelay = 1            -- Initial delay for exponential backoff
local lastTeleportAttempt = 0   -- Timestamp of last teleport call

-- File System Path Setup
local FOLDER_NAME = "JobIdClaims"
local MY_FILE_PATH = string.format("%s/%d.json", FOLDER_NAME, LocalPlayer.UserId)

if isfolder and makefolder and not isfolder(FOLDER_NAME) then
    makefolder(FOLDER_NAME)
end

----------------------------------------------------------------
-- AUTO-CLEANING STALE CLAIM FILES
----------------------------------------------------------------

local function cleanupStaleFiles()
    if listfiles and delfile and readfile then
        local success, files = pcall(listfiles, FOLDER_NAME)
        if success and files then
            local currentTime = os.time()
            for _, filePath in ipairs(files) do
                local readSuccess, content = pcall(readfile, filePath)
                if readSuccess and content then
                    local decodeSuccess, parsed = pcall(HttpService.JSONDecode, HttpService, content)
                    if decodeSuccess and parsed and parsed.updatedAt then
                        if (currentTime - parsed.updatedAt) > 900 then
                            pcall(delfile, filePath)
                        end
                    end
                end
            end
        end
    end
end

task.spawn(cleanupStaleFiles)

----------------------------------------------------------------
-- FILE SYSTEM CACHING (WITH RESERVATION PRESERVATION)
----------------------------------------------------------------

local cachedClaimedJobs = {}
local lastCacheUpdate = 0

local function claimServer(targetJobId)
    if writefile then
        local claimData = {
            userId = LocalPlayer.UserId,
            username = LocalPlayer.Name,
            jobId = targetJobId or CurrentJobId,
            updatedAt = os.time()
        }
        pcall(writefile, MY_FILE_PATH, HttpService:JSONEncode(claimData))
        return claimData
    end
    return nil
end

local function fetchJobs()
    local currentTime = os.time()
    if (currentTime - lastCacheUpdate) < 3 and next(cachedClaimedJobs) ~= nil then
        return cachedClaimedJobs
    end

    local claimedJobs = {}
    if listfiles and readfile then
        local success, files = pcall(listfiles, FOLDER_NAME)
        if success and files then
            for _, filePath in ipairs(files) do
                local readSuccess, content = pcall(readfile, filePath)
                if readSuccess and content then
                    local decodeSuccess, parsed = pcall(HttpService.JSONDecode, HttpService, content)
                    if decodeSuccess and parsed and parsed.jobId and parsed.userId then
                        if parsed.updatedAt and (currentTime - parsed.updatedAt) < 600 then
                            if not claimedJobs[parsed.jobId] or (parsed.updatedAt < claimedJobs[parsed.jobId].updatedAt) then
                                claimedJobs[parsed.jobId] = parsed
                            end
                        end
                    end
                end
            end
        end
    end

    -- Preserve recent local pre-reservations when updating cache from disk
    for jobId, memoryClaim in pairs(cachedClaimedJobs) do
        if memoryClaim.userId == LocalPlayer.UserId and (currentTime - memoryClaim.updatedAt) < 30 then
            if not claimedJobs[jobId] then
                claimedJobs[jobId] = memoryClaim
            end
        end
    end

    cachedClaimedJobs = claimedJobs
    lastCacheUpdate = currentTime
    return claimedJobs
end

