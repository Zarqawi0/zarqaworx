----------------------------------------------------------------
-- CONFIGURATION & CONSTANTS
----------------------------------------------------------------

local MAX_SERVER_INDEX = 299
local MAX_TARGET_PLAYERS = 3 -- Target servers with 0 to 3 players when scanning
local MAX_CLAIM_PLAYERS = 4  -- Only claim if player count is <= 4
local MAX_ALLOWED_PLAYERS = 4 -- Max allowed players before hopping (5+ triggers hop)
local CLAIM_EXPIRATION_TIME = 30 -- Override claims older than 30 seconds if active here
local PROTECTED_USERNAME = "amine100a"

local isHopping = false
local LastHopMethod = nil
local LastAttemptedJobId = nil
local visitedServers = {}

----------------------------------------------------------------
-- SHARED LOCAL FILE SYSTEM (JSON CLAIM SYSTEM)
----------------------------------------------------------------

local FOLDER_NAME = "JobIdClaims"
local MY_FILE_PATH = string.format("%s/%d.json", FOLDER_NAME, LocalPlayer.UserId)

if isfolder and makefolder then
    if not isfolder(FOLDER_NAME) then
        makefolder(FOLDER_NAME)
    end
end

-- Auto-claim target Job ID and save to local JSON file
local function claimServer(targetJobId)
    if writefile then
        local claimData = {
            userId = LocalPlayer.UserId,
            username = LocalPlayer.Name,
            jobId = targetJobId or CurrentJobId,
            updatedAt = os.time(),
            preciseTime = os.clock()
        }
        local success = pcall(writefile, MY_FILE_PATH, HttpService:JSONEncode(claimData))
        return success, claimData
    end
    return false, nil
end

-- Register/Claim current active Job ID
local function registerJob()
    local success = claimServer(CurrentJobId)
    return success
end

-- Fetch all active server claims from JSON files
local function fetchJobs()
    local claimedJobs = {}
    
    if listfiles and readfile then
        local success, files = pcall(listfiles, FOLDER_NAME)
        if success and files then
            for _, filePath in ipairs(files) do
                local readSuccess, content = pcall(readfile, filePath)
                if readSuccess and content then
                    local decodeSuccess, parsed = pcall(HttpService.JSONDecode, HttpService, content)
                    if decodeSuccess and parsed and parsed.jobId and parsed.userId then
                        -- Discard stale claims (>10 minutes)
                        if parsed.updatedAt and (os.time() - parsed.updatedAt) < 600 then
                            if not claimedJobs[parsed.jobId] or (parsed.updatedAt < claimedJobs[parsed.jobId].updatedAt) then
                                claimedJobs[parsed.jobId] = parsed
                            end
                        end
                    end
                end
            end
            return claimedJobs
        end
    end
    
    return nil
end

