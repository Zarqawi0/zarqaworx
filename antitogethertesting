--------------------------------------------------------------------------------
-- CLAIM & CONFLICT RESOLUTION SYSTEM
--------------------------------------------------------------------------------
local function GetClaimingPlayers()
    local claimingPlayers = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player:FindFirstChild("ServerClaimOwner") then
            table.insert(claimingPlayers, player)
        end
    end
    return claimingPlayers
end

local function ResolveClaimConflict()
    local claimingPlayers = GetClaimingPlayers()
    local count = #Players:GetPlayers()

    -- If no player holds a claim and range is 1-4, attempt local claim
    if #claimingPlayers == 0 then
        if count >= 1 and count <= 4 then
            if not LocalPlayer:FindFirstChild("ServerClaimOwner") then
                local tag = Instance.new("BoolValue")
                tag.Name = "ServerClaimOwner"
                tag.Value = true
                tag.Parent = LocalPlayer
            end
            ClaimLabel.Text = "Claim Status: Owned by YOU"
            ClaimLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
            return true -- Successfully claimed
        end
        return false
    end

    -- Conflict Resolution: If another player holds a claim
    if #claimingPlayers > 0 then
        for _, owner in ipairs(claimingPlayers) do
            if owner ~= LocalPlayer then
                -- Tie-breaker: Compare UserIds to determine priority
                if LocalPlayer.UserId > owner.UserId then
                    -- Lower UserId wins; LocalPlayer loses and must hop
                    ClaimLabel.Text = "Claim Status: Yielded to " .. owner.Name
                    ClaimLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
                    
                    local myTag = LocalPlayer:FindFirstChild("ServerClaimOwner")
                    if myTag then myTag:Destroy() end
                    return false -- Conflict lost
                end
            end
        end
    end

    -- LocalPlayer holds the legitimate claim
    ClaimLabel.Text = "Claim Status: Owned by YOU"
    ClaimLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
    return true
end

--------------------------------------------------------------------------------
-- SERVER FETCHING & HOPPING (STRICT 1-3 PLAYER TARGET)
--------------------------------------------------------------------------------
local function fetchServers(cursor)
    local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", PlaceId)
    if cursor then
        url = url .. "&cursor=" .. cursor
    end
    
    local success, response = pcall(function()
        return requestFunc({ Url = url, Method = "GET" })
    end)
    
    if success and response and response.Body then
        local successDecode, decoded = pcall(function()
            return HttpService:JSONDecode(response.Body)
        end)
        if successDecode then return decoded end
    end
    return nil
end

local isSearching = false
local function HopToLowServer()
    if isSearching then return end
    isSearching = true

    UpdateUI("Searching 1-3 Player Server...", Color3.fromRGB(255, 180, 50), "Scanning candidate list...")

    local scanCount = 0
    while true do
        scanCount = scanCount + 1
        local cursor = nil
        local candidates = {}
        
        local pageSkipTarget = math.random(0, 3) 
        local currentPage = 0

        print(string.format("[ServerFinder] Scanning servers (Pass #%d | Random Page #%d)...", scanCount, pageSkipTarget))

        repeat
            local data = fetchServers(cursor)
            if data and data.data then
                currentPage = currentPage + 1
                
                if currentPage >= pageSkipTarget then
                    for _, server in ipairs(data.data) do
                        if server.playing >= 1 and server.playing <= 3 and server.id ~= game.JobId then
                            table.insert(candidates, server)
                        end
                    end
                end
                
                cursor = data.nextPageCursor
            else
                break
            end
            task.wait(0.15)
        until not cursor or #candidates >= 5

        if #candidates > 0 then
            local randomIndex = math.random(1, math.min(#candidates, 5))
            local selectedServer = candidates[randomIndex]
            
            UpdateUI("Teleporting...", Color3.fromRGB(100, 255, 100), string.format("Target ID (%d players)", selectedServer.playing))
            print(string.format("[ServerFinder] Target server found (%d players)! Teleporting to Server ID: %s", selectedServer.playing, tostring(selectedServer.id)))
            
            local teleportSuccess, err = pcall(function()
                TeleportService:TeleportToPlaceInstance(PlaceId, selectedServer.id, LocalPlayer)
            end)

            if not teleportSuccess then
                print("[ServerFinder] Teleport failed: " .. tostring(err) .. ". Resetting search state...")
                UpdateUI("Teleport Failed", Color3.fromRGB(255, 80, 80), "Retrying in 1.5s...")
                isSearching = false
            end
            return
        end

        UpdateUI("No 1-3 Player Server", Color3.fromRGB(255, 150, 50), "Retrying scan in 1.5s...")
        task.wait(1.5)
    end
end

--------------------------------------------------------------------------------
-- CHECK & MONITORING LOGIC
--------------------------------------------------------------------------------
local function CheckAndHop()
    local count = #Players:GetPlayers()

    -- 1. Check if server reaches 5 or more players -> Immediate Hop
    if count >= 5 then
        UpdateUI("Hopping Server", Color3.fromRGB(255, 80, 80), string.format("Player count reached %d (>= 5)", count))
        HopToLowServer()
        return
    end

    -- 2. Resolve claims and script conflict
    local isClaimValid = ResolveClaimConflict()
    if not isClaimValid and count >= 1 then
        UpdateUI("Script Conflict!", Color3.fromRGB(255, 80, 80), "Other script user detected - Hopping...")
        task.wait(0.2)
        HopToLowServer()
        return
    else
        if count >= 1 and count <= 4 then
            UpdateUI("Monitoring", Color3.fromRGB(100, 255, 100), "Server safe and claimed. Waiting...")
        end
    end
end

-- Event Listeners
Players.PlayerRemoving:Connect(function()
    task.wait(0.3)
    CheckAndHop()
end)

Players.PlayerAdded:Connect(function()
    CheckAndHop()
end)

