----------------------------------------------------------------
-- FETCH ROBLOX SERVERS
----------------------------------------------------------------

local function fetchServers(cursor)
    local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", PlaceId)
    if cursor then url = url .. "&cursor=" .. cursor end

    local success, response = pcall(function()
        return requestFunc({ Url = url, Method = "GET" })
    end)

    if success and response and response.Body then
        local successDecode, decoded = pcall(function()
            return HttpService:JSONDecode(response.Body)
        end)
        if successDecode then return decoded end
    end
    return nil
end

----------------------------------------------------------------
-- FORWARD DECLARATIONS
----------------------------------------------------------------

local checkPlayerCount
local checkCurrentServer
local jobIdHop
local findServer

----------------------------------------------------------------
-- FIND SERVER PROCESS
----------------------------------------------------------------

findServer = function()
    UpdateUI("Searching 0-3 Players...", Color3.fromRGB(255, 180, 50))

    local claimedJobs = fetchJobs()
    if not claimedJobs then
        return nil
    end

    local cursor = nil
    local totalScanned = 0
    local maxPages = 10
    local pageCount = 0

    while pageCount < maxPages do
        pageCount = pageCount + 1
        local data = fetchServers(cursor)
        
        if not data or not data.data then 
            break 
        end

        local validServersInBatch = {}

        for _, server in ipairs(data.data) do
            totalScanned = totalScanned + 1
            if totalScanned > (MAX_SERVER_INDEX + 1) then 
                break 
            end

            local playingCount = tonumber(server.playing)
            local maxServerPlayers = tonumber(server.maxPlayers) or (MAX_ALLOWED_PLAYERS + 1)

            local notCurrentServer = server.id ~= CurrentJobId
            local isTargetCount = playingCount ~= nil and playingCount >= 0 and playingCount <= MAX_TARGET_PLAYERS
            local playerCountValid = playingCount ~= nil and playingCount <= MAX_ALLOWED_PLAYERS
            local notFull = playingCount ~= nil and playingCount < maxServerPlayers
            local notOwned = claimedJobs[server.id] == nil
            local notVisited = not visitedServers[server.id]

            if notCurrentServer and isTargetCount and playerCountValid and notFull and notOwned and notVisited then
                table.insert(validServersInBatch, server)
            end
        end

        if #validServersInBatch > 0 then
            local selectedServer = validServersInBatch[math.random(1, #validServersInBatch)]
            claimServer(selectedServer.id)
            return selectedServer.id
        end

        cursor = data.nextPageCursor
        if not cursor or totalScanned >= (MAX_SERVER_INDEX + 1) then
            break
        end

        task.wait(0.1)
    end

    if next(visitedServers) then 
        visitedServers = {} 
    end

    return nil
end

----------------------------------------------------------------
-- JOBID HOP PROCESS (WITH AUTO RESET ON NO SERVER FOUND)
----------------------------------------------------------------

jobIdHop = function()
    if isHopping == false then
        return false
    end

    local serverId = findServer()

    if not serverId then
        print("No suitable server found. Resetting hop state to attempt re-claiming current server.")
        UpdateUI("No Server Found", Color3.fromRGB(255, 150, 50))
        
        -- Reset hopping flag so the account can reclaim the current server if valid
        isHopping = false
        task.wait(1)
        checkCurrentServer()
        return false
    end

    LastHopMethod = "jobid"
    LastAttemptedJobId = serverId
    visitedServers[serverId] = os.time()

    UpdateUI("Teleporting...", Color3.fromRGB(100, 255, 100))

    local teleportSuccess = pcall(function()
        TeleportService:TeleportToPlaceInstance(PlaceId, serverId, LocalPlayer)
    end)

    if not teleportSuccess then
        LastAttemptedJobId = nil
        task.wait(0.5)
        if isHopping then
            return jobIdHop()
        end
    end

    return true
end

----------------------------------------------------------------
-- CHECK PLAYER COUNT PROCESS
----------------------------------------------------------------

checkPlayerCount = function()
    if isHopping == true then
        return false
    end

    local count = RefreshPlayerCount()

    if IsProtectedPlayerPresent() then
        UpdateUI("Protected Present", Color3.fromRGB(100, 255, 100))
        return true
    end

    if count <= MAX_ALLOWED_PLAYERS then
        UpdateUI("Staying (0-4 Players)", Color3.fromRGB(100, 255, 100))
        return true
    end

    isHopping = true
    UpdateUI("Server Full (>=5)", Color3.fromRGB(255, 80, 80))
    jobIdHop()
    return false
end

----------------------------------------------------------------
-- CHECK & CLAIM CURRENT SERVER
----------------------------------------------------------------

checkCurrentServer = function()
    local count = RefreshPlayerCount()
    local protectedPresent = IsProtectedPlayerPresent()

    if (not protectedPresent) and (count > MAX_ALLOWED_PLAYERS) then
        isHopping = true
        UpdateUI("Server Full (>=5)", Color3.fromRGB(255, 80, 80))
        jobIdHop()
        return false
    end

    local claimedJobs = fetchJobs()
    if claimedJobs then
        local claimInfo = claimedJobs[CurrentJobId]

        if claimInfo and claimInfo.userId ~= LocalPlayer.UserId then
            -- Override claim if the owner hasn't updated in >30 seconds or if you are alone
            local claimAge = os.time() - (claimInfo.updatedAt or 0)
            if claimAge > CLAIM_EXPIRATION_TIME or count == 1 then
                print("Claim on current server is stale or account is alone. Overwriting claim...")
                local regSuccess = registerJob()
                if regSuccess then
                    isHopping = false
                    UpdateUI("Claimed Server (0-4)", Color3.fromRGB(100, 255, 100))
                    return true
                end
            else
                isHopping = true
                UpdateUI("Already Claimed (Hopping)", Color3.fromRGB(255, 80, 80))
                print("Server owned by " .. tostring(claimInfo.username) .. ". Hopping away...")
                jobIdHop()
                return true
            end
        end

        if claimInfo and claimInfo.userId == LocalPlayer.UserId then
            isHopping = false
            registerJob()
            UpdateUI("Owned By Account", Color3.fromRGB(100, 255, 100))
            return true
        end
    end

    if count <= MAX_CLAIM_PLAYERS then
        local regSuccess = registerJob()
        if regSuccess then
            isHopping = false
            print("Successfully claimed current server Job ID: " .. tostring(CurrentJobId))
            UpdateUI("Claimed Server (0-4)", Color3.fromRGB(100, 255, 100))
            return true
        end
    end

    return false
end

