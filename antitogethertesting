----------------------------------------------------------------
-- FETCH ROBLOX SERVERS
----------------------------------------------------------------

local function fetchServers(cursor)
    local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", PlaceId)
    if cursor then url = url .. "&cursor=" .. cursor end

    local success, response = pcall(function()
        return requestFunc({ Url = url, Method = "GET" })
    end)

    if success and response and response.Body then
        local successDecode, decoded = pcall(function()
            return HttpService:JSONDecode(response.Body)
        end)
        if successDecode then return decoded end
    end
    return nil
end

----------------------------------------------------------------
-- FORWARD DECLARATIONS
----------------------------------------------------------------

local checkPlayerCount
local checkCurrentServer
local jobIdHop
local findServer

----------------------------------------------------------------
-- FIND SERVER PROCESS
----------------------------------------------------------------

findServer = function()
    UpdateUI("Searching 0-3 Players...", Color3.fromRGB(255, 180, 50))

    local claimedJobs = fetchJobs()
    if not claimedJobs then
        return nil
    end

    local currentCursor = nil
    local totalScanned = 0

    while totalScanned < (MAX_SERVER_INDEX + 1) do
        local data = fetchServers(currentCursor)
        
        if data and data.data then
            for _, server in ipairs(data.data) do
                totalScanned = totalScanned + 1
                if totalScanned > (MAX_SERVER_INDEX + 1) then break end

                local playingCount = tonumber(server.playing)
                local validPlayerCount = playingCount ~= nil and playingCount >= 0 and playingCount <= MAX_SEARCH_PLAYERS
                local notCurrentServer = server.id ~= CurrentJobId
                local notVisited = not visitedServers[server.id]
                local notOwned = claimedJobs[server.id] == nil

                if validPlayerCount and notCurrentServer and notVisited and notOwned then
                    return server.id
                end
            end

            currentCursor = data.nextPageCursor
            if not currentCursor then break end
        else
            break
        end

        task.wait(0.2)
    end

    if next(visitedServers) then
        visitedServers = {}
    end

    return nil
end

----------------------------------------------------------------
-- JOBID HOP PROCESS
----------------------------------------------------------------

jobIdHop = function()
    if isHopping == false then
        return false
    end

    local serverId = findServer()

    if not serverId then
        print("No suitable server found (0-3 players)")
        UpdateUI("No Server Found", Color3.fromRGB(255, 150, 50))
        task.wait(1)
        if isHopping then
            return jobIdHop()
        end
        return false
    end

    LastHopMethod = "jobid"
    LastAttemptedJobId = serverId
    visitedServers[serverId] = os.time()

    UpdateUI("Teleporting...", Color3.fromRGB(100, 255, 100))

    local teleportSuccess = pcall(function()
        TeleportService:TeleportToPlaceInstance(PlaceId, serverId, LocalPlayer)
    end)

    if not teleportSuccess then
        LastAttemptedJobId = nil
        task.wait(0.5)
        if isHopping then
            return jobIdHop()
        end
    end

    return true
end

----------------------------------------------------------------
-- CHECK PLAYER COUNT PROCESS
----------------------------------------------------------------

checkPlayerCount = function()
    if isHopping == true then
        return false
    end

    local count = RefreshPlayerCount()

    if IsProtectedPlayerPresent() then
        UpdateUI("Protected Present", Color3.fromRGB(100, 255, 100))
        return true
    end

    -- ONLY HOP IF PLAYER COUNT IS 5 OR MORE (>=5)
    if count > MAX_CLAIM_PLAYERS then
        isHopping = true
        UpdateUI("Server Full (>=5)", Color3.fromRGB(255, 80, 80))
        jobIdHop()
        return false
    end

    UpdateUI("Staying (Valid Count)", Color3.fromRGB(100, 255, 100))
    return true
end

----------------------------------------------------------------
-- CHECK & CLAIM CURRENT SERVER
----------------------------------------------------------------

checkCurrentServer = function()
    local count = RefreshPlayerCount()
    local protectedPresent = IsProtectedPlayerPresent()

    -- HOP ONLY IF PLAYERS >= 5 (AND PROTECTED USER IS NOT HERE)
    if (not protectedPresent) and (count > MAX_CLAIM_PLAYERS) then
        isHopping = true
        UpdateUI("Server Full (>=5)", Color3.fromRGB(255, 80, 80))
        jobIdHop()
        return false
    end

    -- IF WE ARE IN A VALID SERVER (0-4 PLAYERS), CANCEL HOPPING STATE
    isHopping = false

    local claimedJobs = fetchJobs()
    local claimData = claimedJobs[CurrentJobId]

    if claimData then
        if claimData.userId ~= LocalPlayer.UserId then
            isHopping = true
            UpdateUI("Job ID Claimed", Color3.fromRGB(255, 80, 80))
            jobIdHop()
            return false
        else
            registerJob()
            UpdateUI("Owned By Account", Color3.fromRGB(100, 255, 100))
            return true
        end
    end

    UpdateUI("Scanning & Claiming...", Color3.fromRGB(255, 180, 50))
    local regSuccess = registerJob()

    if regSuccess then
        task.wait(0.5)
        local postClaimJobs = fetchJobs()
        local confirmedClaim = postClaimJobs[CurrentJobId]

        if confirmedClaim and confirmedClaim.userId ~= LocalPlayer.UserId then
            isHopping = true
            UpdateUI("Claim Race Lost", Color3.fromRGB(255, 80, 80))
            jobIdHop()
            return false
        end

        print("Successfully scanned and claimed server!")
        UpdateUI("Claimed Server", Color3.fromRGB(100, 255, 100))
        return true
    end

    return false
end

