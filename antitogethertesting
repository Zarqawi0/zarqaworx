----------------------------------------------------------------
-- HTTP EXECUTOR COMPATIBILITY
----------------------------------------------------------------

local requestFunc = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
if not requestFunc then error("No supported HTTP request function found!") end

local function fetchServers(cursor)
    local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100&excludeFullGames=true", PlaceId)
    if cursor then url = url .. "&cursor=" .. cursor end

    local success, response = pcall(requestFunc, { Url = url, Method = "GET" })
    if success and response and response.Body then
        local successDecode, decoded = pcall(HttpService.JSONDecode, HttpService, response.Body)
        if successDecode then return decoded end
    end
    return nil
end

----------------------------------------------------------------
-- CORE CONTROLLER FUNCTIONS
----------------------------------------------------------------

local checkCurrentServer
local jobIdHop

local function findServer()
    UpdateUI("Searching 0-3 Players...", Color3.fromRGB(255, 180, 50))
    local allSaved = fetchAllSavedJobs()
    
    local cursor = nil
    local totalScanned = 0
    local pageCount = 0

    while pageCount < 10 do
        pageCount = pageCount + 1
        local data = fetchServers(cursor)
        if not data or not data.data then break end

        local validServers = {}

        for _, server in ipairs(data.data) do
            if totalScanned > MAX_SERVER_INDEX then break end
            totalScanned = totalScanned + 1

            local playingCount = tonumber(server.playing)
            if playingCount and playingCount >= 0 and playingCount <= MAX_TARGET_PLAYERS then
                -- Skip any JobId that is already saved or locked
                local isSaved = allSaved[server.id] ~= nil
                if server.id ~= CurrentJobId and not isSaved and not visitedServers[server.id] then
                    table.insert(validServers, server.id)
                end
            end
        end

        if #validServers > 0 then
            local selectedId = validServers[math.random(1, #validServers)]
            
            -- Lock and pre-reserve the selected JobId file as "unclaimed"
            writeJobClaim(selectedId, "unclaimed")
            return selectedId
        end

        cursor = data.nextPageCursor
        if not cursor or totalScanned > MAX_SERVER_INDEX then break end
        task.wait(0.1)
    end

    if next(visitedServers) then visitedServers = {} end
    return nil
end

jobIdHop = function()
    if isHopping then return false end
    
    isHopping = true

    local now = os.time()
    local timeSinceLastHop = now - lastTeleportAttempt
    if timeSinceLastHop < TELEPORT_COOLDOWN then
        local waitTime = TELEPORT_COOLDOWN - timeSinceLastHop
        UpdateUI(string.format("Throttling (%ds)...", waitTime), Color3.fromRGB(255, 180, 50))
        task.wait(waitTime)
    end

    lastTeleportAttempt = os.time()

    local serverId = findServer()

    if not serverId then
        UpdateUI("No Server Found", Color3.fromRGB(255, 150, 50))
        isHopping = false
        task.wait(1)
        checkCurrentServer()
        return false
    end

    visitedServers[serverId] = os.time()
    UpdateUI("Teleporting...", Color3.fromRGB(100, 255, 100))

    local teleportSuccess = pcall(function()
        TeleportService:TeleportToPlaceInstance(PlaceId, serverId, LocalPlayer)
    end)

    if not teleportSuccess then
        isHopping = false
        task.wait(retryDelay)
        retryDelay = math.min(retryDelay * 2, 10)
        return jobIdHop()
    end

    return true
end

checkCurrentServer = function()
    -- Step 1: Acquire lock before evaluating existing records
    acquireServerLock(CurrentJobId)

    local existingRecord = readJobClaim(CurrentJobId)

    -- If a record exists and belongs to ANOTHER player, release lock and hop immediately
    if existingRecord and existingRecord.userId ~= LocalPlayer.UserId then
        releaseServerLock(CurrentJobId)
        UpdateUI("Server Already Saved (Hopping)", Color3.fromRGB(255, 80, 80))
        jobIdHop()
        return false
    end

    -- Write initial "unclaimed" record for local player
    writeJobClaim(CurrentJobId, "unclaimed")

    local count = RefreshPlayerCount()

    -- Step 2: Capacity Check (5+ players)
    if count > MAX_ALLOWED_PLAYERS then
        releaseServerLock(CurrentJobId)
        UpdateUI("Server Full (>=5)", Color3.fromRGB(255, 80, 80))
        jobIdHop()
        return false
    end

    -- Step 3: Multi-player conflict resolution (UserId tie-breaker for unclaimed servers)
    local allPlayers = Players:GetPlayers()
    if #allPlayers > 1 then
        local myUserId = LocalPlayer.UserId
        local hasHigherUserIdInServer = false

        for _, plr in ipairs(allPlayers) do
            if plr ~= LocalPlayer and plr.UserId < myUserId then
                hasHigherUserIdInServer = true
                break
            end
        end

        if hasHigherUserIdInServer then
            releaseServerLock(CurrentJobId)
            UpdateUI("Higher UserId Present (Hopping)", Color3.fromRGB(255, 80, 80))
            jobIdHop()
            return false
        end
    end

    -- Step 4: Mark status as "claimed" if all checks pass
    writeJobClaim(CurrentJobId, "claimed")
    releaseServerLock(CurrentJobId)

    isHopping = false
    retryDelay = 1
    UpdateUI("Server Claimed", Color3.fromRGB(100, 255, 100))
    return true
end

----------------------------------------------------------------
-- LISTENERS & STARTUP INITIALIZATION
----------------------------------------------------------------

TeleportService.TeleportInitFailed:Connect(function()
    isHopping = false
    task.wait(retryDelay)
    retryDelay = math.min(retryDelay * 2, 10)
    checkCurrentServer()
end)

Players.PlayerAdded:Connect(function()
    if not isHopping then checkCurrentServer() end
end)

Players.PlayerRemoving:Connect(function()
    if not isHopping then checkCurrentServer() end
end)

-- Forced Initial Evaluation on Join
task.spawn(function()
    UpdateUI("Verifying Server...", Color3.fromRGB(255, 200, 50))
    task.wait(1)
    local canStay = checkCurrentServer()
    
    if canStay then
        print("[Claim Guard] Server verified, locked, and successfully claimed!")
    end
end)

-- Background Heartbeat Loop
task.spawn(function()
    while task.wait(HEARTBEAT_INTERVAL) do
        checkCurrentServer()
    end
end)
