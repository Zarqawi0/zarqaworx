--------------------------------------------------------------------------------
-- HIDDEN CHAT-BASED CLAIM NETWORK
--------------------------------------------------------------------------------
local CLAIM_PREFIX = "[CROWNED_HUB_CLAIM]:"
local serverOwnerUserId = nil
local myClaimTime = os.clock()

-- HIDE CLAIM MESSAGES FROM LOCAL CHAT WINDOW
if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
    TextChatService.OnIncomingMessage = function(message: TextChatMessage)
        local props = Instance.new("TextChatMessageProperties")
        if message.Text:find(CLAIM_PREFIX, 1, true) then
            -- Make message invisible in the chat UI
            props.Text = ""
            props.PrefixText = ""
        end
        return props
    end
end

-- Broadcast claim safely
local function BroadcastClaim()
    local message = CLAIM_PREFIX .. tostring(LocalPlayer.UserId) .. ":" .. tostring(myClaimTime)
    
    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        local generalChannel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
        if generalChannel then
            pcall(function() generalChannel:SendAsync(message) end)
        end
    else
        -- Legacy Chat System
        local defaultChatSystemChatEvents = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        if defaultChatSystemChatEvents then
            local sayMessageRequest = defaultChatSystemChatEvents:FindFirstChild("SayMessageRequest")
            if sayMessageRequest then
                pcall(function() sayMessageRequest:FireServer(message, "All") end)
            end
        end
    end
end

-- Process incoming claim messages
local function ProcessClaimMessage(sender, message)
    if not message:find(CLAIM_PREFIX, 1, true) then return end
    
    local parts = string.split(message, ":")
    if #parts >= 3 then
        local senderUserId = tonumber(parts[2])
        local senderClaimTime = tonumber(parts[3])

        if senderUserId and senderClaimTime then
            if senderClaimTime < myClaimTime or (senderClaimTime == myClaimTime and senderUserId < LocalPlayer.UserId) then
                serverOwnerUserId = senderUserId
            end
        end
    end
end

-- Listen for player chats
local function RegisterChatListener(player)
    player.Chatted:Connect(function(msg)
        ProcessClaimMessage(player, msg)
    end)
end

for _, player in ipairs(Players:GetPlayers()) do
    RegisterChatListener(player)
end
Players.PlayerAdded:Connect(RegisterChatListener)

