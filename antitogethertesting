--------------------------------------------------------------------------------
-- CLAIM & CONFLICT RESOLUTION SYSTEM
--------------------------------------------------------------------------------
local hasPrintedClaim = false

local function ClearClaimTag()
    if LocalPlayer and LocalPlayer:FindFirstChild("ServerClaimOwner") then
        LocalPlayer.ServerClaimOwner:Destroy()
    end
end

local function GetClaimingPlayers()
    local claimingPlayers = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player and player:FindFirstChild("ServerClaimOwner") then
            table.insert(claimingPlayers, player)
        end
    end
    return claimingPlayers
end

local function ResolveClaimConflict()
    if not LocalPlayer then return false end

    local count = #Players:GetPlayers()

    -- Must have 1 to 4 players to hold or claim a server
    if count < 1 or count > 4 then
        ClearClaimTag()
        ClaimLabel.Text = "Claim Status: Unclaimed (Invalid Count)"
        ClaimLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
        hasPrintedClaim = false
        return false
    end

    local claimingPlayers = GetClaimingPlayers()

    -- Dynamic reclaim check: If nobody currently holds the claim tag (or claim owner left), claim it
    if #claimingPlayers == 0 then
        if not LocalPlayer:FindFirstChild("ServerClaimOwner") then
            local tag = Instance.new("BoolValue")
            tag.Name = "ServerClaimOwner"
            tag.Value = true
            tag.Parent = LocalPlayer
        end
        
        ClaimLabel.Text = "Claim Status: Owned by YOU"
        ClaimLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
        
        if not hasPrintedClaim then
            hasPrintedClaim = true
            print(string.format("[ServerFinder] Server CLAIMED by %s | Players: %d/5", LocalPlayer.Name, count))
        end
        return true
    end

    -- Conflict resolution if multiple clients have claim tags
    for _, owner in ipairs(claimingPlayers) do
        if owner and owner ~= LocalPlayer then
            if LocalPlayer.UserId > owner.UserId then
                ClaimLabel.Text = "Claim Status: Yielded to " .. owner.Name
                ClaimLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
                
                ClearClaimTag()
                hasPrintedClaim = false
                return false
            end
        end
    end

    -- LocalPlayer holds the valid lower UserId claim
    ClaimLabel.Text = "Claim Status: Owned by YOU"
    ClaimLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
    if not hasPrintedClaim then
        hasPrintedClaim = true
        print(string.format("[ServerFinder] Server CLAIMED by %s | Players: %d/5", LocalPlayer.Name, count))
    end
    return true
end

--------------------------------------------------------------------------------
-- SERVER FETCHING & HOPPING
--------------------------------------------------------------------------------
local function fetchServers(cursor)
    local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", PlaceId)
    if cursor then
        url = url .. "&cursor=" .. cursor
    end
    
    local success, response = pcall(function()
        return requestFunc({ Url = url, Method = "GET" })
    end)
    
    if success and response and response.Body then
        local successDecode, decoded = pcall(function()
            return HttpService:JSONDecode(response.Body)
        end)
        if successDecode then return decoded end
    end
    return nil
end

local isSearching = false
local function HopToLowServer()
    if isSearching then return end
    isSearching = true

    UpdateUI("Searching 1-3 Player Server...", Color3.fromRGB(255, 180, 50), "Scanning candidate list...")

    local scanCount = 0
    while true do
        scanCount = scanCount + 1
        
        -- Pick a random index between 0 and 299 to convert into page depth offsets
        local randomIndex = math.random(0, 299)
        local targetSkipPages = math.floor(randomIndex / 100)

        print(string.format("[ServerFinder] Pass #%d | Random Starting Index: %d (Skip Pages: %d)...", scanCount, randomIndex, targetSkipPages))

        local cursor = nil
        local candidates = {}
        local currentPage = 0

        repeat
            local data = fetchServers(cursor)
            if data and data.data then
                currentPage = currentPage + 1
                
                if currentPage >= targetSkipPages then
                    for _, server in ipairs(data.data) do
                        -- 1. Target range strictly between 1 and 3 players
                        local validPlayerCount = server.playing >= 1 and server.playing <= 3
                        -- 2. Prevent teleporting to the same server
                        local notCurrentServer = server.id ~= game.JobId
                        -- 3. Inline/Queue Check: Reject server if players are waiting in queue
                        local noInlineQueue = not server.queuedPlayers or #server.queuedPlayers == 0

                        if validPlayerCount and notCurrentServer and noInlineQueue then
                            table.insert(candidates, server)
                        end
                    end
                end
                
                cursor = data.nextPageCursor
            else
                break
            end
            task.wait(0.15)
        until not cursor or #candidates >= 10

        -- Pick 5 random candidate servers from the gathered pool
        if #candidates > 0 then
            local randomPool = {}
            local candidateCopy = { unpack(candidates) }
            
            for i = 1, math.min(5, #candidateCopy) do
                local pickIdx = math.random(1, #candidateCopy)
                table.insert(randomPool, candidateCopy[pickIdx])
                table.remove(candidateCopy, pickIdx)
            end

            -- Pick 1 server from the 5 selected random servers
            local selectedServer = randomPool[math.random(1, #randomPool)]
            
            UpdateUI("Teleporting...", Color3.fromRGB(100, 255, 100), string.format("Target ID (%d players)", selectedServer.playing))
            print(string.format("[ServerFinder] Target server found (%d players)! Teleporting to Server ID: %s", selectedServer.playing, tostring(selectedServer.id)))
            
            local teleportSuccess, err = pcall(function()
                TeleportService:TeleportToPlaceInstance(PlaceId, selectedServer.id, LocalPlayer)
            end)

            if not teleportSuccess then
                print("[ServerFinder] Teleport failed: " .. tostring(err) .. ". Retrying scan loop...")
                UpdateUI("Teleport Failed", Color3.fromRGB(255, 80, 80), "Retrying in 1.5s...")
                isSearching = false
            end
            return
        end

        UpdateUI("No Valid Server", Color3.fromRGB(255, 150, 50), "Retrying scan loop in 1.5s...")
        task.wait(1.5)
    end
end

--------------------------------------------------------------------------------
-- CHECK & MONITORING LOGIC
--------------------------------------------------------------------------------
local function CheckAndHop()
    local count = #Players:GetPlayers()

    -- 1. Hop immediately if player count is 5 or more
    if count >= 5 then
        hasPrintedClaim = false
        ClearClaimTag()
        UpdateUI("Hopping Server", Color3.fromRGB(255, 80, 80), string.format("Player count reached %d (>= 5)", count))
        HopToLowServer()
        return
    end

    -- 2. Resolve claims dynamically and hop on conflict losing state
    local isClaimValid = ResolveClaimConflict()
    if not isClaimValid and count >= 1 and count <= 4 then
        UpdateUI("Script Conflict!", Color3.fromRGB(255, 80, 80), "Yielded to lower UserId - Hopping...")
        task.wait(0.2)
        HopToLowServer()
        return
    else
        if count >= 1 and count <= 4 then
            UpdateUI("Monitoring", Color3.fromRGB(100, 255, 100), "Server safe and claimed. Waiting...")
        end
    end
end

-- Continuous claim monitoring when player leaves (enabling auto-reclaim)
Players.PlayerRemoving:Connect(function()
    hasPrintedClaim = false
    task.wait(0.3)
    CheckAndHop()
end)

Players.PlayerAdded:Connect(function()
    CheckAndHop()
end)

--------------------------------------------------------------------------------
-- CONTINUOUS MONITORING LOOP
--------------------------------------------------------------------------------
task.spawn(function()
    while true do
        CheckAndHop()
        task.wait(0.5)
    end
end)
