--------------------------------------------------------------------------------
-- CLAIM & UNCLAIM TRACKING SYSTEM
--------------------------------------------------------------------------------
local hasPrintedClaim = false

local function ClearClaimTag()
    if LocalPlayer and LocalPlayer:FindFirstChild("ServerClaimOwner") then
        LocalPlayer.ServerClaimOwner:Destroy()
    end
end

local function GetClaimingPlayers()
    local claimingPlayers = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player and player:FindFirstChild("ServerClaimOwner") then
            table.insert(claimingPlayers, player)
        end
    end
    return claimingPlayers
end

local function ResolveClaimConflict()
    if not LocalPlayer then return false end

    local count = #Players:GetPlayers()
    if count < 0 or count > 4 then
        ClearClaimTag()
        hasPrintedClaim = false
        return false
    end

    local claimingPlayers = GetClaimingPlayers()

    -- If no player currently holds a claim tag, LocalPlayer claims the server
    if #claimingPlayers == 0 then
        if not LocalPlayer:FindFirstChild("ServerClaimOwner") then
            local tag = Instance.new("BoolValue")
            tag.Name = "ServerClaimOwner"
            tag.Value = true
            tag.Parent = LocalPlayer
        end
        
        if not hasPrintedClaim then
            hasPrintedClaim = true
            print(string.format("[ServerFinder] Server CLAIMED by %s | Players: %d/5", LocalPlayer.Name, count))
        end
        return true
    end

    -- Conflict Resolution: Yield if someone else holds a claim tag
    for _, owner in ipairs(claimingPlayers) do
        if owner and owner ~= LocalPlayer then
            if LocalPlayer.UserId > owner.UserId or owner:FindFirstChild("ServerClaimOwner") then
                ClearClaimTag()
                hasPrintedClaim = false
                return false
            end
        end
    end

    if not hasPrintedClaim then
        hasPrintedClaim = true
        print(string.format("[ServerFinder] Server CLAIMED by %s | Players: %d/5", LocalPlayer.Name, count))
    end
    return true
end

