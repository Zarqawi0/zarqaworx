--------------------------------------------------------------------------------
-- REPLICATED CLAIM SYSTEM
--------------------------------------------------------------------------------
local hasPrintedClaim = false

local function ClearClaimTag()
    if LocalPlayer and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("ServerClaimOwner") then
        LocalPlayer.Character.ServerClaimOwner:Destroy()
    end
end

local function ResolveClaimConflict()
    if not LocalPlayer or not LocalPlayer.UserId then return false end

    local char = LocalPlayer.Character
    if not char then return false end

    local totalPlayers = #Players:GetPlayers()
    if totalPlayers >= 5 then
        ClearClaimTag()
        hasPrintedClaim = false
        return false
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player and player.UserId and player ~= LocalPlayer and player.Character then
            local otherHasTag = player.Character:FindFirstChild("ServerClaimOwner") ~= nil
            if otherHasTag then
                if LocalPlayer.UserId > player.UserId then
                    ClearClaimTag()
                    hasPrintedClaim = false
                    return false
                end
            end
        end
    end

    if not char:FindFirstChild("ServerClaimOwner") then
        local tag = Instance.new("BoolValue")
        tag.Name = "ServerClaimOwner"
        tag.Value = true
        tag.Parent = char
    end

    if not hasPrintedClaim then
        hasPrintedClaim = true
        print(string.format("[Crowned Hub] Server CLAIMED by %s | Players: %d/5", LocalPlayer.Name, totalPlayers))
    end
    
    return true
end

--------------------------------------------------------------------------------
-- SERVER FETCHING & HOPPING (FIXED NIL CHECKS)
--------------------------------------------------------------------------------
local function fetchServers(cursor)
    local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", PlaceId)
    if cursor then
        url = url .. "&cursor=" .. cursor
    end
    
    local success, response = pcall(function()
        return requestFunc({ Url = url, Method = "GET" })
    end)
    
    if success and response and response.Body then
        local successDecode, decoded = pcall(function()
            return HttpService:JSONDecode(response.Body)
        end)
        if successDecode then return decoded end
    end
    return nil
end

local isSearching = false
local function HopToLowServer()
    if isSearching then return end
    isSearching = true

    UpdateUI("Searching...", Color3.fromRGB(255, 180, 50))

    while true do
        local cursor = nil
        local candidates = {}

        repeat
            local data = fetchServers(cursor)
            if data and data.data then
                for _, server in ipairs(data.data) do
                    -- Nil Guard: Ensure playing field exists and is a valid number
                    local playingCount = tonumber(server.playing)
                    local validPlayerCount = playingCount ~= nil and playingCount >= 0 and playingCount <= 3
                    
                    local notCurrentServer = server.id ~= game.JobId
                    local notVisited = not visitedServers[server.id]
                    local noInlineQueue = not server.queuedPlayers or #server.queuedPlayers == 0

                    if validPlayerCount and notCurrentServer and notVisited and noInlineQueue then
                        table.insert(candidates, server)
                    end
                end
                cursor = data.nextPageCursor
            else
                break
            end
            task.wait(0.1)
        until not cursor or #candidates >= 15

        if #candidates > 0 then
            local selectedServer = candidates[math.random(1, #candidates)]
            visitedServers[selectedServer.id] = os.time()
            
            UpdateUI("Teleporting...", Color3.fromRGB(100, 255, 100))
            
            local teleportSuccess = pcall(function()
                TeleportService:TeleportToPlaceInstance(PlaceId, selectedServer.id, LocalPlayer)
            end)

            if not teleportSuccess then
                UpdateUI("Teleport Failed", Color3.fromRGB(255, 80, 80))
                isSearching = false
                task.wait(1)
            end
            return
        end

        UpdateUI("Scanning...", Color3.fromRGB(255, 150, 50))
        task.wait(1)
    end
end

TeleportService.TeleportInitFailed:Connect(function(player, teleportResult, errorMessage)
    if player == LocalPlayer then
        UpdateUI("Hop Cancelled", Color3.fromRGB(255, 80, 80))
        isSearching = false
        task.wait(1)
        HopToLowServer()
    end
end)

--------------------------------------------------------------------------------
-- MONITORING LOOP
--------------------------------------------------------------------------------
local function CheckAndHop()
    if isSearching then return end

    local count = #Players:GetPlayers()
    if count >= 5 then
        hasPrintedClaim = false
        ClearClaimTag()
        UpdateUI("Hopping...", Color3.fromRGB(255, 80, 80))
        HopToLowServer()
        return
    end

    local isClaimValid = ResolveClaimConflict()
    if not isClaimValid then
        UpdateUI("Yielding Server...", Color3.fromRGB(255, 80, 80))
        task.wait(0.5)
        HopToLowServer()
    else
        UpdateUI("Claimed", Color3.fromRGB(100, 255, 100))
    end
end

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    CheckAndHop()
end)

Players.PlayerRemoving:Connect(function()
    hasPrintedClaim = false
    task.wait(0.3)
    CheckAndHop()
end)

Players.PlayerAdded:Connect(function()
    task.wait(0.2)
    CheckAndHop()
end)

task.spawn(function()
    task.wait((LocalPlayer.UserId % 10) * 0.05)
    while true do
        CheckAndHop()
        task.wait(0.5)
    end
end)
