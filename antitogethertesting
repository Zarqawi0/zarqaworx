--------------------------------------------------------------------------------
-- HTTP EXECUTOR COMPATIBILITY
--------------------------------------------------------------------------------
local requestFunc = nil
if syn and syn.request then requestFunc = syn.request
elseif http and http.request then requestFunc = http.request
elseif http_request then requestFunc = http_request
elseif fluxus and fluxus.request then requestFunc = fluxus.request
elseif request then requestFunc = request
else error("No supported HTTP request function found!") end

--------------------------------------------------------------------------------
-- INFINITE SERVER HOPPER LOOP (STRICT 0-3 TARGET SEARCH)
--------------------------------------------------------------------------------
local function fetchServers(cursor)
    local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", PlaceId)
    if cursor then url = url .. "&cursor=" .. cursor end
    
    local success, response = pcall(function()
        return requestFunc({ Url = url, Method = "GET" })
    end)
    
    if success and response and response.Body then
        local successDecode, decoded = pcall(function()
            return HttpService:JSONDecode(response.Body)
        end)
        if successDecode then return decoded end
    end
    return nil
end

local isSearching = false

local function HopToLowServer()
    if isSearching then return end
    isSearching = true

    UpdateUI("Searching 0-3...", Color3.fromRGB(255, 180, 50))

    -- Loops indefinitely until a join succeeds into a 0-3 player server
    while true do
        local cursor = nil
        local candidates = {}

        repeat
            local data = fetchServers(cursor)
            if data and data.data then
                for _, server in ipairs(data.data) do
                    local playingCount = tonumber(server.playing)
                    -- Hard constraint: MUST be 0 to 3 players
                    local validPlayerCount = playingCount ~= nil and playingCount >= 0 and playingCount <= 3
                    local notCurrentServer = server.id ~= CurrentJobId
                    local notVisited = not visitedServers[server.id]

                    if validPlayerCount and notCurrentServer and notVisited then
                        table.insert(candidates, server)
                    end
                end
                cursor = data.nextPageCursor
            else
                break
            end
            task.wait(0.1)
        until not cursor or #candidates >= 15

        if #candidates > 0 then
            -- Random offset selection (math.random(3, #candidates)) prevents 2 script users hitting the exact same server
            local minIndex = math.min(3, #candidates)
            local selectedIndex = math.random(minIndex, #candidates)
            local selectedServer = candidates[selectedIndex]

            visitedServers[selectedServer.id] = os.time()
            
            print("JobTrack: Target Server Found - " .. tostring(selectedServer.id) .. " (" .. tostring(selectedServer.playing) .. "/5 players)")

            UpdateUI("Teleporting...", Color3.fromRGB(100, 255, 100))
            
            local teleportSuccess = pcall(function()
                TeleportService:TeleportToPlaceInstance(PlaceId, selectedServer.id, LocalPlayer)
            end)

            if teleportSuccess then
                task.wait(8)
            end

            -- Resume loop automatically if teleport gets canceled or times out
            UpdateUI("Retrying Hop...", Color3.fromRGB(255, 80, 80))
            task.wait(0.5)
        else
            -- If cache fills up without finding 0-3 servers, wipe visited cache and keep retrying
            if next(visitedServers) then
                visitedServers = {}
            end
            UpdateUI("Scanning...", Color3.fromRGB(255, 150, 50))
            task.wait(1)
        end
    end
end

--------------------------------------------------------------------------------
-- MONITORING & CONFLICT DISCOVERY
--------------------------------------------------------------------------------
-- Resume search instantly if game engine fails or cancels teleport
TeleportService.TeleportInitFailed:Connect(function()
    isSearching = false
    UpdateUI("Teleport Canceled", Color3.fromRGB(255, 80, 80))
    task.defer(HopToLowServer)
end)

local function CheckAndHop()
    RefreshPlayerCount()
    if isSearching then return end

    local count = #Players:GetPlayers()

    -- Requirement: Automatically hop if server has 5 or more players
    if count >= 5 then
        UpdateUI("Server Full (5+)", Color3.fromRGB(255, 80, 80))
        HopToLowServer()
        return
    end

    -- Requirement: Claim server JobId if player count is 0 to 4
    local isOwner = IsCurrentServerClaimedByMe()

    if not isOwner then
        -- Requirement: When another script user joins a claimed server, auto-hop the second user
        UpdateUI("Yielding JobId...", Color3.fromRGB(255, 80, 80))
        task.wait(0.3)
        HopToLowServer()
    else
        UpdateUI("Claimed (" .. string.sub(tostring(CurrentJobId), 1, 6) .. ")", Color3.fromRGB(100, 255, 100))
    end
end

-- Monitor player entry/exit to trigger instant yield response for incoming users
Players.PlayerAdded:Connect(function()
    task.wait(0.1)
    CheckAndHop()
end)

Players.PlayerRemoving:Connect(function()
    task.wait(0.1)
    CheckAndHop()
end)

task.spawn(function()
    while true do
        CheckAndHop()
        task.wait(1)
    end
end)
