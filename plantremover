--------------------------------------------------------------------------------
-- SERVER CLAIMING MECHANISM (SCRIPT-TO-SCRIPT COMMUNICATION)
--------------------------------------------------------------------------------
local CLAIM_TAG = "[SCRIPT_SERVER_CLAIM_V1]"
local RESP_TAG  = "[SCRIPT_SERVER_TAKEN_V1]"

local isServerOwner = false
local isConflictFound = false

-- Send a hidden handshake signal via text channels or legacy chat
local function SendSignal(msg)
    pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local generalChannel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
            if generalChannel then
                generalChannel:SendAsync(msg)
            end
        else
            ReplicatedStorage.DefaultChatSystemChatEvents.SayMessageRequest:FireServer(msg, "All")
        end
    end)
end

-- Listen for other script users claiming or answering claims
local function ListenForClaims()
    -- Modern TextChatService Listener
    pcall(function()
        TextChatService.MessageReceived:Connect(function(message)
            if not message.TextSource then return end
            if message.TextSource.UserId == LocalPlayer.UserId then return end
            
            if message.Text == CLAIM_TAG then
                -- Someone else joined and is checking if server is claimed
                if isServerOwner then
                    SendSignal(RESP_TAG) -- Inform them this server is already claimed
                end
            elseif message.Text == RESP_TAG then
                -- Another user already claims this server
                isConflictFound = true
            end
        end)
    end)

    -- Player Chat Fallback
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            player.Chatted:Connect(function(msg)
                if msg == CLAIM_TAG and isServerOwner then
                    SendSignal(RESP_TAG)
                elseif msg == RESP_TAG then
                    isConflictFound = true
                end
            end)
        end
    end

    Players.PlayerAdded:Connect(function(player)
        player.Chatted:Connect(function(msg)
            if msg == CLAIM_TAG and isServerOwner then
                SendSignal(RESP_TAG)
            elseif msg == RESP_TAG then
                isConflictFound = true
            end
        end)
    end)
end

ListenForClaims()

