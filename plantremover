--------------------------------------------------------------------------------
-- SCRIPT OCCUPANCY & CLAIM HANDSHAKE
--------------------------------------------------------------------------------
local CLAIM_TAG = "[SCRIPT_SERVER_CLAIM_V2]"
local RESP_TAG  = "[SCRIPT_SERVER_TAKEN_V2]"

local isServerOwner = false
local isConflictFound = false

local function SendSignal(msg)
    pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local generalChannel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
            if generalChannel then generalChannel:SendAsync(msg) end
        else
            ReplicatedStorage.DefaultChatSystemChatEvents.SayMessageRequest:FireServer(msg, "All")
        end
    end)
end

local function ListenForClaims()
    pcall(function()
        TextChatService.MessageReceived:Connect(function(message)
            if not message.TextSource or message.TextSource.UserId == LocalPlayer.UserId then return end
            if message.Text == CLAIM_TAG and isServerOwner then
                SendSignal(RESP_TAG)
            elseif message.Text == RESP_TAG then
                isConflictFound = true
            end
        end)
    end)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            player.Chatted:Connect(function(msg)
                if msg == CLAIM_TAG and isServerOwner then SendSignal(RESP_TAG)
                elseif msg == RESP_TAG then isConflictFound = true end
            end)
        end
    end

    Players.PlayerAdded:Connect(function(player)
        player.Chatted:Connect(function(msg)
            if msg == CLAIM_TAG and isServerOwner then SendSignal(RESP_TAG)
            elseif msg == RESP_TAG then isConflictFound = true end
        end)
    end)
end

ListenForClaims()

--------------------------------------------------------------------------------
-- SERVER FETCHING WITH RANDOM INDEX & BATCH SELECTION
--------------------------------------------------------------------------------
local function fetchServers(cursor)
    local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", PlaceId)
    if cursor then
        url = url .. "&cursor=" .. cursor
    end
    
    local success, response = pcall(function()
        return requestFunc({ Url = url, Method = "GET" })
    end)
    
    if success and response and response.Body then
        local successDecode, decoded = pcall(function()
            return HttpService:JSONDecode(response.Body)
        end)
        if successDecode then return decoded end
    end
    return nil
end

local isSearching = false
local function HopToLowServer()
    if isSearching then return end
    isSearching = true
    isServerOwner = false

    local scanCount = 0
    while true do
        scanCount = scanCount + 1
        local cursor = nil
        local candidates = {}
        
        -- Jump to a random offset between 0 and 299 by advancing pages randomly
        local pageSkipTarget = math.random(0, 3) 
        local currentPage = 0

        UpdateUI(string.format("Scanning (Pass #%d | Offset Page #%d)...", scanCount, pageSkipTarget), Color3.fromRGB(255, 180, 0))

        repeat
            local data = fetchServers(cursor)
            if data and data.data then
                currentPage = currentPage + 1
                
                -- Collect servers matching 1-3 player criteria
                if currentPage >= pageSkipTarget then
                    for _, server in ipairs(data.data) do
                        if server.playing >= 1 and server.playing <= 3 and server.id ~= game.JobId then
                            table.insert(candidates, server)
                        end
                    end
                end
                
                cursor = data.nextPageCursor
            else
                break
            end
            task.wait(0.15)
        -- Collect until we have at least 5 candidates or run out of pages
        until not cursor or #candidates >= 5

        -- If we found candidates, randomly select from up to 5 matching servers
        if #candidates > 0 then
            -- Random index between 1 and total found candidates (max 5)
            local randomIndex = math.random(1, math.min(#candidates, 5))
            local selectedServer = candidates[randomIndex]
            
            UpdateUI(string.format("Selected server (%d players)! Teleporting...", selectedServer.playing), Color3.fromRGB(0, 255, 120))
            TeleportService:TeleportToPlaceInstance(PlaceId, selectedServer.id, LocalPlayer)
            return
        end

        UpdateUI("No suitable 1-3 player server found. Retrying...", Color3.fromRGB(255, 80, 80))
        task.wait(1.5)
    end
end

local function CheckAndHop()
    local count = #Players:GetPlayers()
    PlayerCountLabel.Text = string.format("Current Players: %d (Max limit: 5)", count)

    if count >= 5 then
        UpdateUI("Server reached 5+ players! Hopping...", Color3.fromRGB(255, 100, 100))
        HopToLowServer()
        return
    end

    -- Verify if another script user is already in this server ("inline" check)
    isConflictFound = false
    UpdateUI("Checking for inline script users...", Color3.fromRGB(255, 255, 0))
    SendSignal(CLAIM_TAG)
    task.wait(1)

    if isConflictFound then
        UpdateUI("Inline user detected! Hopping to another...", Color3.fromRGB(255, 50, 50))
        task.wait(0.5)
        HopToLowServer()
    else
        isServerOwner = true
        UpdateUI("Server active & safe! Monitoring...", Color3.fromRGB(0, 200, 255))
    end
end

-- Initialize Loop
task.spawn(function()
    task.wait(1.5)
    CheckAndHop()
end)

Players.PlayerAdded:Connect(function()
    CheckAndHop()
end)

Players.PlayerRemoving:Connect(function()
    task.wait(0.1)
    CheckAndHop()
end)
