local function fetchServers(cursor)
    local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", PlaceId)
    if cursor then
        url = url .. "&cursor=" .. cursor
    end
    
    local success, response = pcall(function()
        return requestFunc({
            Url = url,
            Method = "GET"
        })
    end)
    
    if success and response and response.Body then
        local successDecode, decoded = pcall(function()
            return HttpService:JSONDecode(response.Body)
        end)
        if successDecode then return decoded end
    end
    return nil
end

local isSearching = false
local function HopToLowServer()
    if isSearching then return end
    isSearching = true
    isServerOwner = false

    local scanCount = 0
    
    while true do
        scanCount = scanCount + 1
        
        -- Pick a random page jump within the first 300 servers (Pages 0, 1, or 2)
        local targetPage = math.random(0, 2)
        local cursor = nil
        
        UpdateUI(string.format("Navigating to page %d (Index range %d-299)...", targetPage + 1, targetPage * 100), Color3.fromRGB(255, 180, 0))
        
        -- Traverse cursors to hit target page
        for i = 1, targetPage do
            local pageData = fetchServers(cursor)
            if pageData and pageData.nextPageCursor then
                cursor = pageData.nextPageCursor
                task.wait(0.1)
            else
                break
            end
        end
        
        -- Fetch server list for selected page
        local data = fetchServers(cursor)
        local validServers = {}

        if data and data.data then
            -- Collect all 1-3 player servers on this page
            for _, server in ipairs(data.data) do
                if (server.playing >= 1 and server.playing <= 3) and server.id ~= game.JobId then
                    table.insert(validServers, server)
                end
            end
        end

        -- If valid servers exist, pick up to 5 random candidates
        if #validServers > 0 then
            local candidates = {}
            local availablePool = {unpack(validServers)}
            
            -- Extract up to 5 random options from the pool
            for i = 1, math.min(5, #availablePool) do
                local randomIndex = math.random(1, #availablePool)
                table.insert(candidates, availablePool[randomIndex])
                table.remove(availablePool, randomIndex)
            end

            -- Pick 1 final server from the 5 random candidates
            local selectedServer = candidates[math.random(1, #candidates)]
            
            UpdateUI(string.format("Selected 1 of %d random candidates (%d players)! Teleporting...", #candidates, selectedServer.playing), Color3.fromRGB(0, 255, 120))
            
            TeleportService:TeleportToPlaceInstance(PlaceId, selectedServer.id, LocalPlayer)
            task.wait(6)
            
            isSearching = false
            return
        end

        UpdateUI("No 1-3 player server in range. Retrying scan in 2s...", Color3.fromRGB(255, 80, 80))
        task.wait(2)
    end
end

local function CheckAndHop()
    local count = #Players:GetPlayers()
    PlayerCountLabel.Text = string.format("Current Players: %d (Max limit: 5)", count)

    if count >= 5 then
        UpdateUI("Server reached 5+ players! Hopping...", Color3.fromRGB(255, 100, 100))
        HopToLowServer()
        return
    end

    isConflictFound = false
    UpdateUI("Verifying server ownership...", Color3.fromRGB(255, 255, 0))
    SendSignal(CLAIM_TAG)
    task.wait(1)

    if isConflictFound then
        UpdateUI("Server claimed by another script user! Hopping...", Color3.fromRGB(255, 50, 50))
        task.wait(0.5)
        HopToLowServer()
    else
        isServerOwner = true
        UpdateUI("Server claimed! Monitoring...", Color3.fromRGB(0, 200, 255))
    end
end

-- Initialize Monitoring
task.spawn(function()
    task.wait(1.5)
    CheckAndHop()
end)

Players.PlayerAdded:Connect(function()
    CheckAndHop()
end)

Players.PlayerRemoving:Connect(function()
    task.wait(0.1)
    CheckAndHop()
end)
