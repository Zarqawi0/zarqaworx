-- TAB SYSTEM
--------------------------------------------------------------------------------
local tabs = {}
local currentTab = nil

local function createTab(name, iconText)
    local page = Instance.new("ScrollingFrame")
    page.Name = name .. "Page"
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 3
    page.ScrollBarImageColor3 = Color3.fromRGB(50, 50, 65)
    page.Visible = false
    page.ZIndex = 2
    page.Parent = contentContainer

    local pageLayout = Instance.new("UIListLayout")
    pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    pageLayout.Padding = UDim.new(0, 10)
    pageLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    pageLayout.Parent = page

    local pagePadding = Instance.new("UIPadding")
    pagePadding.PaddingTop = UDim.new(0, 10)
    pagePadding.PaddingLeft = UDim.new(0, 20)
    pagePadding.PaddingRight = UDim.new(0, 20)
    pagePadding.PaddingBottom = UDim.new(0, 20)
    pagePadding.Parent = page

    -- Nav Button
    local navBtn = Instance.new("TextButton")
    navBtn.Name = name .. "Tab"
    navBtn.Size = UDim2.new(0, 145, 0, 36)
    navBtn.BackgroundColor3 = Color3.fromRGB(11, 11, 14)
    navBtn.Text = ""
    navBtn.AutoButtonColor = false
    navBtn.ZIndex = 4
    navBtn.Parent = navList

    local navCorner = Instance.new("UICorner")
    navCorner.CornerRadius = UDim.new(0, 8)
    navCorner.Parent = navBtn

    local navIcon = Instance.new("TextLabel")
    navIcon.Name = "Icon"
    navIcon.Size = UDim2.new(0, 20, 1, 0)
    navIcon.Position = UDim2.new(0, 12, 0, 0)
    navIcon.BackgroundTransparency = 1
    navIcon.Text = iconText or "•"
    navIcon.TextColor3 = Color3.fromRGB(120, 120, 135)
    navIcon.TextSize = 14
    navIcon.Font = Enum.Font.GothamMedium
    navIcon.ZIndex = 4
    navIcon.Parent = navBtn

    local navLabel = Instance.new("TextLabel")
    navLabel.Name = "Label"
    navLabel.Size = UDim2.new(1, -40, 1, 0)
    navLabel.Position = UDim2.new(0, 36, 0, 0)
    navLabel.BackgroundTransparency = 1
    navLabel.Text = name
    navLabel.TextColor3 = Color3.fromRGB(120, 120, 135)
    navLabel.TextSize = 13
    navLabel.Font = Enum.Font.GothamMedium
    navLabel.TextXAlignment = Enum.TextXAlignment.Left
    navLabel.ZIndex = 4
    navLabel.Parent = navBtn

    local tabData = {
        Button = navBtn,
        Page = page,
        Icon = navIcon,
        Label = navLabel,
        Name = name
    }

    local function activate()
        if currentTab == tabData then return end

        for _, t in pairs(tabs) do
            t.Page.Visible = false
            TweenService:Create(t.Button, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(11, 11, 14)}):Play()
            TweenService:Create(t.Icon, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(120, 120, 135)}):Play()
            TweenService:Create(t.Label, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(120, 120, 135)}):Play()
        end

        currentTab = tabData
        headerTitle.Text = name
        page.Visible = true

        TweenService:Create(navBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(22, 22, 30)}):Play()
        TweenService:Create(navIcon, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(114, 137, 218)}):Play()
        TweenService:Create(navLabel, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
    end

    navBtn.MouseButton1Click:Connect(activate)

    navBtn.MouseEnter:Connect(function()
        if currentTab ~= tabData then
            TweenService:Create(navBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(16, 16, 22)}):Play()
            TweenService:Create(navLabel, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(180, 180, 195)}):Play()
        end
    end)

    navBtn.MouseLeave:Connect(function()
        if currentTab ~= tabData then
            TweenService:Create(navBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(11, 11, 14)}):Play()
            TweenService:Create(navLabel, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(120, 120, 135)}):Play()
        end
    end)

    table.insert(tabs, tabData)

    if #tabs == 1 then
        activate()
    end

    return page
end

