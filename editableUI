-- Function to create Navigation Buttons
local function createNavButton(name, isActive, order)
    local Button = Instance.new("Frame")
    Button.Name = name .. "Btn"
    Button.Size = UDim2.new(1, 0, 0, 40)
    Button.LayoutOrder = order
    Button.BackgroundColor3 = isActive and Color3.fromRGB(18, 24, 42) or Color3.fromRGB(12, 12, 18)
    Button.BorderSizePixel = 0
    Button.Parent = NavContainer

    local ButtonCorner = Instance.new("UICorner")
    ButtonCorner.CornerRadius = UDim.new(0, 8)
    ButtonCorner.Parent = Button

    -- Active Indicator Bar (Left Highlight)
    if isActive then
        local Indicator = Instance.new("Frame")
        Indicator.Size = UDim2.new(0, 4, 0, 20)
        Indicator.Position = UDim2.new(0, 8, 0.5, -10)
        Indicator.BackgroundColor3 = Color3.fromRGB(35, 115, 255)
        Indicator.BorderSizePixel = 0
        Indicator.Parent = Button

        local IndCorner = Instance.new("UICorner")
        IndCorner.CornerRadius = UDim.new(0, 2)
        IndCorner.Parent = Indicator
    end

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, -30, 1, 0)
    Label.Position = UDim2.new(0, isActive and 24 or 15, 0, 0)
    Label.BackgroundTransparency = 1
    Label.Text = name
    Label.TextColor3 = Color3.fromRGB(240, 240, 240)
    Label.TextSize = 14
    Label.Font = Enum.Font.GothamMedium
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Button

    return Button
end

createNavButton("Info", true, 1)
createNavButton("Main", false, 2)
createNavButton("Gear", false, 3)
createNavButton("History Logs", false, 4)

